# Test harness settings for a LAPTOP. Sourced by bin/300-run-tests and, when
# TEST_PG_URL_BASE is not already set, by bin/510 / 515 -- so every entry
# point sees the same values and nothing has a default hidden in a script.
#
# The one assumption: a Postgres listening on PGHOST:PGPORT below whose
# `postgres` role can create databases. Nothing cares what serves it -- the
# loc-postgres container (doc/050-dev-env-init.md), a native server, anything
# else. psql and the migrator both connect to that one address, so they can
# never land on different servers.
#
# A build host gets its own copy of this file with a CI role; point
# TEST_ENV at it.

# PSQL overrides the psql command outright, for a Postgres that TCP cannot
# reach (e.g. PSQL="docker exec -i loc-postgres psql -U postgres"). The
# migrator always uses TEST_PG_URL_BASE, so an override must point at the
# same server.
# The one place the password is written; the URLs below are built from it.
export PGUSER=postgres
export PGPASSWORD='localHighQuality*Password'
export PGHOST=127.0.0.1
export PGPORT=5432

# The two scratch databases. Both are dropped and rebuilt by every full run;
# bin/510 refuses any name that does not end in _test_db or _e2e_db.
# Names derive from APP_SLUG (etc/app.env, sourced by every script before this file)
export TEST_DB=loc_${APP_SLUG}_test_db
export E2E_DB=loc_${APP_SLUG}_e2e_db

# bin/510 hands `migrate up` this base plus the scratch database name.
export TEST_PG_URL_BASE="postgres://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT"

# Go repository suite (src/api-srv/internal/repository/testdb_test.go).
export TEST_DATABASE_URL="$TEST_PG_URL_BASE/$TEST_DB"

# Playwright and the pytest runner: the config their API instance starts with
# (relative to the project root; bin/300 and playwright.config.ts resolve it).
export E2E_API_ENV=etc/e2e-api-srv.env

# Where bin/300-run-tests leaves go-test.log, api.log etc. (gitignored).
export TEST_LOG_DIR=tmp/test-logs
