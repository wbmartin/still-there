# API server config for the END-TO-END suites (Playwright via
# src/web-app/playwright.config.ts, pytest via bin/200-run-tests py). Same
# shape as loc-api-srv.env and differing from it in exactly these ways, each
# deliberate:
#
#   - DATABASE_URL is inline and points at loc_proto_e2e_db, NOT the
#     dev loc_proto_db and NOT loc_proto_test_db. The Go
#     repository suite already owns _test_db and creates and deletes rows in
#     it; sharing would make a Playwright failure and a `go test` failure able
#     to cause each other. bin/513-reset-e2e-db builds this database.
#   - Port 8082, bound to loopback, so the developer's stack on 8080 keeps
#     running through a test run and the well-known password below is never
#     reachable from the network even for the minute the suite takes.
#   - CORS_ALLOWED_ORIGINS is ONLY the e2e web port (5182).
#
# The user is the same one bin/510 seeds: admin / admin123!  (fixtures).

# proto_app_svc_account is the role sql/roles.sql creates and the one the
# deployed server connects as, so the e2e run exercises the same grants.
DATABASE_URL=postgres://proto_app_svc_account:reallygoodPSQLpassword@127.0.0.1:5432/loc_proto_e2e_db

# Local scratch values only. TOTP_ENCRYPTION_KEY must be 32 bytes as hex (AES-256).
JWT_SECRET=loc-e2e-only-jwt-secret-not-for-any-deployed-environment
TOTP_ENCRYPTION_KEY=6c6f632d6532652d6f6e6c792d746f74702d6b65792d6e6f742d6465706c6f79

JWT_SESSION_EXPIRE_HOURS=72

FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# Raised far above the production value ON PURPOSE, and the number is a
# finding rather than a convenience.
#
# In the app this was ported from, four page loads of the smoke suite
# exceeded 200 requests/minute -- a startup request burst of roughly fifty
# requests per page load -- and until that is fixed the rate limiter, not the
# application, decides whether the suite passes. A test run that dies at
# request 201 fails every later spec with "Cannot reach the server", which
# points at the infrastructure rather than at the burst that caused it.
#
# Lifting it here keeps the limiter from masking real failures. It does NOT
# fix any burst, and a burst is still worth fixing. The pytest suite also
# logs in many times per run as the unauthenticated limiter counts it.
MAX_USER_REQ_PER_MIN=100000
MAX_UNAUTH_REQ_PER_MIN=10000

CORS_ALLOWED_ORIGINS=http://localhost:5182


APP_NAME="Proto App"
SERVER_NAME=proto-api-e2e
ENABLE_TLS=false
SERVER_PORT=8082
# Loopback only: this instance runs with a well-known password and must not
# be reachable from the network even for the minute the suite takes.
SERVER_BIND_ADDRESS=127.0.0.1

TEST_BASE_URL=http://127.0.0.1:8082
