# API server config for the END-TO-END suites (Playwright via
# src/web-app/playwright.config.ts, pytest via bin/300-run-tests py). Same
# shape as loc-api-srv.env and differing from it in exactly these ways, each
# deliberate:
#
#   - DATABASE_URL is inline and points at loc_stillthere_e2e_db, NOT the
#     dev loc_stillthere_db and NOT loc_stillthere_test_db. The Go
#     repository suite already owns _test_db and creates and deletes rows in
#     it; sharing would make a Playwright failure and a `go test` failure able
#     to cause each other. bin/510-reset-test-db loc_stillthere_e2e_db builds
#     this database; bin/515-reseed-db reseeds it without dropping.
#   - Port 8082, bound to loopback, so the developer's stack on 8080 keeps
#     running through a test run and the well-known password below is never
#     reachable from the network even for the minute the suite takes.
#   - CORS_ALLOWED_ORIGINS is ONLY the e2e web port (5182).
#   - ALLOW_MFA_EXEMPT_VIA_API=true: pytest and Playwright create
#     password-only throwaway logins through POST /user and /userInvite.
#   - ISSUE_REPORTS_ENABLED=true: the issue-report module is on, so
#     tests/test_issue_report.py and the route sweep reach it.
#   - HELP_ENABLED=true: the help module is on, so tests/test_help.py,
#     the help e2e spec and the route sweep reach it.
#
# The users are the ones bin/510 seeds (sql/fixtures/test-seed.sql), all in
# the test tenant (2): admin / admin123!, basic / basic123!.

# stillthere_app is the role sql/roles.sql creates and the one the
# deployed server connects as, so the e2e run exercises the same grants.
DATABASE_URL=postgres://stillthere_app:reallygoodPSQLpassword@127.0.0.1:5432/loc_stillthere_e2e_db

# Local scratch values only. TOTP_ENCRYPTION_KEY must be 32 bytes as hex (AES-256).
JWT_SECRET=loc-e2e-only-jwt-secret-not-for-any-deployed-environment
TOTP_ENCRYPTION_KEY=6c6f632d6532652d6f6e6c792d746f74702d6b65792d6e6f742d6465706c6f79

JWT_SESSION_EXPIRE_HOURS=72

FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# Hours an invite link works before it expires (B035).
INVITE_TTL_HOURS=72

# Lets POST/PUT /user and /userInvite turn mfaExempt on (B097). true ONLY
# for the test harness: the suites create password-only throwaway logins.
# Every other file, dev and every server included, says false.
ALLOW_MFA_EXEMPT_VIA_API=true

# Raised far above the production value ON PURPOSE, and the number is a
# finding rather than a convenience.
#
# In the app this was ported from, four page loads of the smoke suite
# exceeded 200 requests/minute -- a startup request burst of roughly fifty
# requests per page load -- and until that is fixed the rate limiter, not the
# application, decides whether the suite passes. A test run that dies at
# request 201 fails every later spec with "Cannot reach the server", which
# points at the infrastructure rather than at the burst that caused it.
#
# Lifting it here keeps the limiter from masking real failures. It does NOT
# fix any burst, and a burst is still worth fixing. The pytest suite also
# logs in many times per run as the unauthenticated limiter counts it.
MAX_USER_REQ_PER_MIN=100000
MAX_UNAUTH_REQ_PER_MIN=10000

# 0: Playwright talks to the API directly. bin/300-run-tests py sets 1 in its
# copy so pytest can play the proxy and give each lockout case its own
# address; safe only because this instance is loopback-bound.
TRUSTED_PROXY_COUNT=0

CORS_ALLOWED_ORIGINS=http://localhost:5182


APP_NAME="Still There"
SERVER_NAME=stillthere-api-e2e
LOG_LEVEL=info
ENABLE_TLS=false
SERVER_PORT=8082
# Loopback only: this instance runs with a well-known password and must not
# be reachable from the network even for the minute the suite takes.
SERVER_BIND_ADDRESS=127.0.0.1

TEST_BASE_URL=http://127.0.0.1:8082

# The load test's login (bin/330-test-load): a non-admin, MFA-exempt seed
# user, so the per-user rate limiter runs on every request. The load test
# reads the password from this file (-env), never from its command line.
# Fixture values for a loopback scratch database only.
TEST_PERSONA_USER=basic
TEST_PERSONA_PASSWORD=basic123!

# The issue-report module on, so the suites reach its routes and page; the
# relay stays off (no ISSUE_RELAY_* keys), so reports stay in the app.
ISSUE_REPORTS_ENABLED=true

# The help module on, so the suites reach its routes and the Help panel.
HELP_ENABLED=true

# Monitoring: how texts go out and how often the watchdog runs.
# SMS_PROVIDER is log (texts written to the log, none sent) or telnyx,
# which also needs TELNYX_API_KEY (secret), TELNYX_FROM_NUMBER (E.164),
# TELNYX_MESSAGING_PROFILE_ID and TELNYX_PUBLIC_KEY (webhook signatures).
SMS_PROVIDER=log
WATCHDOG_TICK_SECONDS=5

# Inbound texts from the SMS relay (src/sms-relay): optional, off when
# absent; all three or none. SMS_RELAY_TOKEN is a secret (the relay keeps
# only its SHA-256 in CONSUMER_TOKEN_LIST): never committed.
# SMS_RELAY_URL=http://127.0.0.1:8095
# SMS_RELAY_TOKEN=SERVERONLY
# SMS_RELAY_QUEUE=stillthere
