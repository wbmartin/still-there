# The one place this app's identity lives. Every bin/ script sources
# it; bin/000-rebrand rewrites it and the flat files that cannot source it.
#
#   APP_SLUG          lower-case, [a-z0-9]: binaries dist/<slug>-api and
#                     <slug>-migrate, local databases loc_<slug>_{db,test_db,e2e_db},
#                     presales service uat-<slug>-api under /srv/uat-<slug>,
#                     Postgres roles <slug>_app / <slug>_ddl / <slug>_ci
#                     (doc/340-db-host-setup.md).
#   APP_DISPLAY_NAME  what people see: web title, login page, TOTP issuer
#                     (as APP_NAME in the API env files).
APP_SLUG=stillthere
APP_DISPLAY_NAME="Still There"
