# Presales UAT deploy settings, sourced by bin/600-bundle-uat on the laptop.
# Committed on purpose: nothing here is a secret. Point PRESALES_ENV at another
# file to override the whole set; there are no per-variable env overrides and
# no defaults in the scripts -- a missing key stops the run and names itself.
#
# 600 copies APP_NAME, APP_ROOT, SERVICE, SVC_USER and DB_APP_ROLE into the
# bundle as deploy.env; bin/610-deploy-uat (deploy.sh on the server) sources that, then
# $APP_ROOT/etc/deploy.env if the host keeps one, which wins.

# --- laptop side ---------------------------------------------------------------
# bin/600 sources etc/app.env first; APP_SLUG names everything below.
APP_NAME=$APP_SLUG
# ssh alias for the UAT host (~/.ssh/config), used for scp and the hand-off line.
UAT_HOST=uat-server
# docker container whose pg_dump produces db.sql
PG_CONTAINER=loc-postgres
# local API env whose inline DATABASE_URL names the database to dump
LOCAL_ENV_FILE=etc/loc-api-srv.env

# --- server side (shipped in the bundle as deploy.env) --------------------------
APP_ROOT=/srv/uat-$APP_SLUG
SERVICE=uat-$APP_SLUG-api
SVC_USER=www-data
# Postgres role that owns the restored database and everything in it; the API
# connects as it too (presales model: one DML role owns the schema). Must be a
# role src/api-srv/sql/roles.sql creates -- 600 checks. Post-sales splits this
# so proto_ddl owns the schema: doc/330-presales-to-postsales-migration.md.
DB_APP_ROLE=${APP_SLUG}_app
