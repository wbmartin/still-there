# Presales UAT deploy settings, sourced by bin/600-bundle-uat on the laptop.
# Committed on purpose: nothing here is a secret. Point PRESALES_ENV at another
# file to override the whole set; there are no per-variable env overrides and
# no defaults in the scripts -- a missing key stops the run and names itself.
#
# 600 copies APP_NAME, APP_ROOT, SERVICE, SVC_USER, DB_APP_ROLE and UAT_DOMAIN
# into the bundle as deploy.env; bin/610-deploy-uat (deploy.sh on the server) sources that, then
# $APP_ROOT/etc/deploy.env if the host keeps one, which wins. 600 also fills
# etc/uat-api-srv.env.template with names from here and ships it; 610 adds the
# secrets on the host the first time. 600 also ships
# etc/uat-nginx-site.conf.template, which 610 installs once for UAT_DOMAIN.

# --- laptop side ---------------------------------------------------------------
# bin/600 sources etc/app.env first; APP_SLUG names everything below.
APP_NAME=$APP_SLUG
# ssh alias for the UAT host (~/.ssh/config), used for scp and the hand-off line.
UAT_HOST=uat-server
# local API env whose inline DATABASE_URL names the database to dump. Which
# Postgres holds it is not set here: bin/600 and bin/620 take PGHOST, PGPORT,
# PGUSER and PGPASSWORD from etc/loc-test.env, the one file that describes the
# laptop's server, so the dump comes from the same place bin/205 migrated.
LOCAL_ENV_FILE=etc/loc-api-srv.env

# --- server side (shipped in the bundle as deploy.env) --------------------------
APP_ROOT=/srv/uat-$APP_SLUG
SERVICE=uat-$APP_SLUG-api
SVC_USER=www-data
# Postgres role that owns the restored database and everything in it; the API
# connects as it too (presales model: one DML role owns the schema). Must be a
# role src/api-srv/sql/roles.sql creates -- 600 checks. Post-sales splits this
# so proto_ddl owns the schema: doc/330-uat-postsales-cutover.md.
DB_APP_ROLE=${APP_SLUG}_app
# Database the first deploy writes into the generated etc/api-srv.env; later
# deploys read the name back from that file's DATABASE_URL.
DB_NAME=uat_${APP_SLUG}_db
# Public hostname of the UAT site. The first deploy writes and links an nginx
# site for it (etc/uat-nginx-site.conf.template) and prints the certbot line.
# Lower-case letters, digits, dots and hyphens (600 and 610 check). A name
# under example.com is a placeholder: 610 skips the site until it is replaced.
UAT_DOMAIN=uat-$APP_SLUG.example.com
