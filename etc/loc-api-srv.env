# Local dev API config, read by bin/215-run-api-srv. Self-contained: a fresh
# clone runs with no edits and no external service. Every value here
# is local-only; deployed environments carry their own file
# (the host's is infra/prd-wbm/etc/prd-stillthere-api.env) with real secrets that are never committed.

# The role sql/roles.sql creates, on the database bin/510-reset-test-db builds.
DATABASE_URL=postgres://stillthere_app:reallygoodPSQLpassword@127.0.0.1:5432/loc_stillthere_db?sslmode=disable

# Local scratch values only. TOTP_ENCRYPTION_KEY must be 32 bytes as hex (AES-256).
JWT_SECRET=loc-dev-only-jwt-secret-not-for-any-deployed-environment
TOTP_ENCRYPTION_KEY=6c6f632d6465762d6f6e6c792d746f74702d6b65792d6e6f742d6465706c6f79

JWT_SESSION_EXPIRE_HOURS=72

FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# Hours an invite link works before it expires (B035).
INVITE_TTL_HOURS=72

# Whether POST/PUT /user and /userInvite may turn mfaExempt on (B097).
# false: an exempt login skips TOTP, so the API refuses it. Only the test
# harness file says true. The dev logins are exempt from the seed SQL
# (sql/fixtures/local-seed.sql), not through the API, and stay editable:
# PUT /user refuses only turning the flag on.
ALLOW_MFA_EXEMPT_VIA_API=false

MAX_USER_REQ_PER_MIN=200
MAX_UNAUTH_REQ_PER_MIN=20

# Proxies in front of the API that append to X-Forwarded-For. 0: no proxy,
# the header is ignored and the client is RemoteAddr. 1 behind nginx.
TRUSTED_PROXY_COUNT=0

CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_NAME="Still There"
SERVER_NAME=stillthere-api
# debug, info, warn or error. debug adds a line per request and per health poll.
LOG_LEVEL=debug
SERVER_PORT=8080
# Required. Loopback serves the vite proxy (localhost:8080); a phone on the LAN
# reaches vite, not the API. 0.0.0.0 publishes the API on every interface.
SERVER_BIND_ADDRESS=127.0.0.1

ENABLE_TLS=false
# Only read when ENABLE_TLS=true; relative to the directory the server is started from.
TLS_CERT_PATH=etc/crt/api-srv-fullchain.pem
TLS_KEY_PATH=etc/crt/api-srv-privkey.pem

# The issue-report module (doc/150-issue-report-module.md). Off unless
# true: no Report button, every /issueReport* route answers 404. The relay
# that forwards reports to a tracker runs only with all three ISSUE_RELAY_*
# target keys set; the token is a secret, so a repository copy never
# carries them. ISSUE_RELAY_INTERVAL_SECONDS is optional (default 120,
# at least 15).
ISSUE_REPORTS_ENABLED=false
# ISSUE_RELAY_URL=
# ISSUE_RELAY_PROJECT_ID=
# ISSUE_RELAY_TOKEN=
# ISSUE_RELAY_INTERVAL_SECONDS=120

# The help module (doc/151-help-module.md). Off unless true: no Help
# button, no ? key or command palette, and /helpEvent and /helpInsights
# answer 404. The help content is in the web app either way.
HELP_ENABLED=false

# Monitoring: how texts go out and how often the watchdog runs.
# SMS_PROVIDER is log (texts written to the log, none sent) or telnyx,
# which also needs TELNYX_API_KEY (secret), TELNYX_FROM_NUMBER (E.164),
# TELNYX_MESSAGING_PROFILE_ID and TELNYX_PUBLIC_KEY (webhook signatures).
SMS_PROVIDER=log
WATCHDOG_TICK_SECONDS=30
