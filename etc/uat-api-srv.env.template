# Presales UAT API env template (bin/600-bundle-uat, bin/610-deploy-uat).
# No secrets live here. 600 fills the names (__DB_APP_ROLE__, __DB_NAME__,
# __SERVER_NAME__, __APP_DISPLAY_NAME__) from etc/app.env and
# etc/uat-deploy.env and ships the result in the bundle. On the first deploy
# 610 fills __DB_PASSWORD__, __JWT_SECRET__ and __TOTP_KEY__ with values
# generated on the host and writes $APP_ROOT/etc/api-srv.env (root:$SVC_USER
# 0640). It never overwrites that file. See doc/320-presales-uat-deploy.md.

# --- database -----------------------------------------------------------------
# 610 sets the role's password from this URL on every deploy.
DATABASE_URL=postgres://__DB_APP_ROLE__:__DB_PASSWORD__@127.0.0.1:5432/__DB_NAME__?sslmode=disable

# --- secrets --------------------------------------------------------------
JWT_SECRET=__JWT_SECRET__
TOTP_ENCRYPTION_KEY=__TOTP_KEY__

# --- server -----------------------------------------------------------------
SERVER_NAME=__SERVER_NAME__
# debug, info, warn or error. debug adds a line per request and per health poll.
LOG_LEVEL=info
APP_NAME="__APP_DISPLAY_NAME__"
SERVER_PORT=8088
# TLS terminates at nginx; the API listens on loopback only. nginx must be the
# only way in: TRUSTED_PROXY_COUNT=1 trusts one X-Forwarded-For hop, which a
# caller reaching the API directly could forge.
ENABLE_TLS=false
SERVER_BIND_ADDRESS=127.0.0.1
# TLS_CERT_PATH=
# TLS_KEY_PATH=

# --- sessions / auth ----------------------------------------------------------
JWT_SESSION_EXPIRE_HOURS=12
FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# Hours an invite link works before it expires (B035).
INVITE_TTL_HOURS=72

# Whether POST/PUT /user and /userInvite may turn mfaExempt on (B097).
# false: an exempt login skips TOTP, so the API refuses it. Only the test
# harness file says true.
ALLOW_MFA_EXEMPT_VIA_API=false

# --- rate limiting --------------------------------------------------------------
MAX_USER_REQ_PER_MIN=200
MAX_UNAUTH_REQ_PER_MIN=20
# nginx appends the client address to X-Forwarded-For: trust that one hop.
TRUSTED_PROXY_COUNT=1

# --- CORS (nginx serves web-pub on the same origin; usually leave empty on UAT) ---
CORS_ALLOWED_ORIGINS=

# The issue-report module (doc/150-issue-report-module.md): optional, off
# when absent. To turn it on, set ISSUE_REPORTS_ENABLED=true in the
# host's file; the relay to a tracker runs only with all three ISSUE_RELAY_*
# target keys set (the token is a secret: host file only).
# ISSUE_REPORTS_ENABLED=false
# ISSUE_RELAY_URL=SERVERONLY
# ISSUE_RELAY_PROJECT_ID=SERVERONLY
# ISSUE_RELAY_TOKEN=SERVERONLY
# ISSUE_RELAY_INTERVAL_SECONDS=120

# The help module (doc/151-help-module.md): optional, off when absent.
# To turn it on, set HELP_ENABLED=true in the host's file.
# HELP_ENABLED=false
