# Presales nginx site (bin/600-bundle-uat ships it, bin/610-deploy-uat
# installs it). No secrets live here. On the first deploy 610 fills
# __UAT_DOMAIN__ (UAT_DOMAIN, etc/uat-deploy.env), __APP_ROOT__ and __PORT__
# (SERVER_PORT in the host's api-srv.env), writes the result to
# __APP_ROOT__/etc/ as nginx-presales_<domain>, links it into
# /etc/nginx/sites-enabled as <domain> and reloads nginx. It never
# overwrites that file: edit it on the host. HTTP only until `certbot --nginx -d __UAT_DOMAIN__`
# adds the 443 block and the redirect. See doc/320-presales-uat-deploy.md.

server {
    listen 80;
    listen [::]:80;
    server_name __UAT_DOMAIN__;
    access_log __APP_ROOT__/log/nginx_access.log;
    error_log __APP_ROOT__/log/nginx_error.log;
    root __APP_ROOT__/web-pub;
    index index.html;
    client_max_body_size 20M;

    # Security headers are set per web location, never at server level: a
    # location that sets any add_header drops every server-level one, and one
    # that sets none (like /api/) inherits them all on top of its own.
    #
    # The API. The trailing slash strips the /api prefix, because the Go server
    # registers /health, not /api/health. No add_header here: the API's own
    # headers (security.HeadersMiddleware) stand alone.
    location /api/ {
        proxy_pass http://127.0.0.1:__PORT__/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Appends $remote_addr; ClientIP counts TRUSTED_PROXY_COUNT hops from
        # the right, so never overwrite it.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }

    # Hashed filenames, so the content at a given URL never changes. immutable
    # stops the browser revalidating on every navigation.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri =404;
    }

    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri $uri/ /index.html;
    }

    # index.html itself must never be cached, or a deploy leaves browsers
    # asking for hashed assets that no longer exist.
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}
