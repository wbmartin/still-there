# The prd deploy's laptop side, sourced by bin/600-deploy-prd after
# etc/app.env. Committed on purpose: nothing here is a secret. Every key is
# required and the script has no defaults: a missing key stops the run and
# names itself.

# ssh alias for the prd host in the staff laptop's ~/.ssh/config: scp and
# ssh as the staff login, never root (the host was set up for gsd-notes,
# its doc/360; this app shares it).
PRD_SSH_HOST=prd-wbm
# The app root on the host, /srv/<env>-<slug>: the install script, unit and
# env files are named from its basename (infra/prd-wbm/).
APP_ROOT=/srv/prd-stillthere
# The public site, for --check's health call through nginx.
SITE_URL=https://stillthere.teamtaggle.com
