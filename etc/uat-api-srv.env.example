# Redacted copy convention: this is a checked-in EXAMPLE only. Real values live only
# on the host at $APP_ROOT/etc/api-srv.env (e.g. /srv/uat-proto/etc/api-srv.env) — never
# committed. Every secret placeholder below is spelled SERVERONLY; replace each one with
# a real, unique value when you create the file on the host. See doc/320-presales-uat-deploy.md.
#
# This is the presales quick-deploy env shape (inline secrets, matching
# what bin/610-deploy-uat expects at $APP_ROOT/etc/api-srv.env). It intentionally omits

# --- database -----------------------------------------------------------------
# Role must be proto_app (created by 000-roles.sql in the bundle).
DATABASE_URL=postgres://proto_app:SERVERONLY@127.0.0.1:5432/uat_proto_db?sslmode=disable

# --- secrets --------------------------------------------------------------
JWT_SECRET=SERVERONLY
TOTP_ENCRYPTION_KEY=SERVERONLY

# --- server -----------------------------------------------------------------
SERVER_NAME=proto-api
APP_NAME="Proto App"
SERVER_PORT=8088
ENABLE_TLS=false
# TLS_CERT_PATH=
# TLS_KEY_PATH=

# --- sessions / auth ----------------------------------------------------------
JWT_SESSION_EXPIRE_HOURS=72
FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# --- rate limiting --------------------------------------------------------------
MAX_USER_REQ_PER_MIN=200
MAX_UNAUTH_REQ_PER_MIN=20
# nginx appends the client address to X-Forwarded-For: trust that one hop.
TRUSTED_PROXY_COUNT=1

# --- CORS (nginx serves web-pub on the same origin; usually leave empty on UAT) ---
CORS_ALLOWED_ORIGINS=

# --- logging / KV ---------------------------------------------------------------
