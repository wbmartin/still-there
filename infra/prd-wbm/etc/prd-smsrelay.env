# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:svc-smsrelay, chmod 0640  (the relay runs as svc-smsrelay)
# Every key is required (src/sms-relay/README.md, Config).
#
# The relay's DML role. The migrator connects as smsrelay_ddl from
# prd-smsrelay-migrate.env; the relay must never own the schema. The
# password is generated on this host:  openssl rand -hex 32
DATABASE_URL=postgres://smsrelay_app:SERVERONLY@127.0.0.1:5432/prd_smsrelay_db

# Loopback only: nginx (nginx_webhook.teamtaggle.com) is the one way in
# for Telnyx, and the apps on this host read their queues here. 8095:
# gsd-notes has 8088, Still There's API 8090.
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8095

# The Telnyx account's webhook public key (portal, Keys & Credentials,
# Public Key). Not a secret, but set on the host from the portal.
TELNYX_PUBLIC_KEY=SERVERONLY

# <queue>:<sha256 hex of the app's token>, comma separated. The token
# itself is a secret in the app's own env file (Still There:
# SMS_RELAY_TOKEN in prd-stillthere-api.env); only its hash is here.
CONSUMER_TOKEN_LIST=stillthere:SERVERONLY

# Days an acked text is kept before the daily delete.
RETAIN_DAYS=30

# debug, info, warn or error.
LOG_LEVEL=info
