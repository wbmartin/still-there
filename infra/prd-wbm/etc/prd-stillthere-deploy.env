# Settings prd-stillthere-install and prd-stillthere-rollback read. Nothing here is a
# secret, so this repo copy is the host file as it is.
# On the server:  chown root:root, chmod 0644

# The API's systemd unit (etc/prd-stillthere-api.service).
SERVICE=prd-stillthere-api
# The API itself on loopback (SERVER_PORT in prd-stillthere-api.env), not through
# nginx, so the check is of the release and not of the site.
HEALTH_URL=http://127.0.0.1:8090/health
# Seconds to wait for "status":"ok" after a restart before rolling back.
HEALTH_WAIT_SECONDS=30
