# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:root, chmod 0600  (only prd-stillthere-install, as
# root, runs stillthere-migrate; the API's user must not read the DDL password)
# stillthere_ddl owns the schema; see doc/340-db-host-setup.md.
# The password is generated on this host:  openssl rand -hex 32
DATABASE_URL=postgres://stillthere_ddl:SERVERONLY@127.0.0.1:5432/prd_stillthere_db
