# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:svc-stillthere, chmod 0640  (the API runs as svc-stillthere)
#
# The API's DML role (db_reader + db_writer only). The migrator connects as
# stillthere_ddl from prd-stillthere-migrate.env; the API must never own the schema.
# The three secrets below are read inline from this file. Each is generated
# on this host, never copied from another environment:
#   openssl rand -hex 32
# TOTP_ENCRYPTION_KEY encrypts every MFA seed in the database: keep it with
# every backup of the database and restore the two together. A dump restored
# under another key leaves every MFA enrolment undecryptable.

DATABASE_URL=postgres://stillthere_app:SERVERONLY@127.0.0.1:5432/prd_stillthere_db
JWT_SECRET=SERVERONLY
TOTP_ENCRYPTION_KEY=SERVERONLY

JWT_SESSION_EXPIRE_HOURS=12

FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# Hours an invite link works before it expires (B035).
INVITE_TTL_HOURS=72

# Whether POST/PUT /user and /userInvite may turn mfaExempt on (B097).
# false: an exempt login skips TOTP, so the API refuses it. Only the test
# harness file says true.
ALLOW_MFA_EXEMPT_VIA_API=false

MAX_USER_REQ_PER_MIN=200
MAX_UNAUTH_REQ_PER_MIN=20

# nginx appends the client address to X-Forwarded-For: trust that one hop.
TRUSTED_PROXY_COUNT=1

CORS_ALLOWED_ORIGINS=https://stillthere.teamtaggle.com


APP_NAME="Still There"
SERVER_NAME=prd-stillthere-api
# debug, info, warn or error. debug adds a line per request and per health poll.
LOG_LEVEL=info

# TLS terminates at nginx; the API listens on loopback only. 8090: gsd-notes
# has 8088 on this shared host. nginx must be the only way in: TRUSTED_PROXY_COUNT=1 trusts one X-Forwarded-For hop, which a
# caller reaching the API directly could forge.
ENABLE_TLS=false
SERVER_PORT=8090
SERVER_BIND_ADDRESS=127.0.0.1

# The issue-report module (doc/150-issue-report-module.md): optional, off
# when absent. To turn it on, set ISSUE_REPORTS_ENABLED=true in the
# host's file; the relay to a tracker runs only with all three ISSUE_RELAY_*
# target keys set (the token is a secret: host file only).
# ISSUE_REPORTS_ENABLED=false
# ISSUE_RELAY_URL=SERVERONLY
# ISSUE_RELAY_PROJECT_ID=SERVERONLY
# ISSUE_RELAY_TOKEN=SERVERONLY
# ISSUE_RELAY_INTERVAL_SECONDS=120

# The help module (doc/151-help-module.md): optional, off when absent.
# To turn it on, set HELP_ENABLED=true in the host's file.
# HELP_ENABLED=false

# Monitoring: how texts go out and how often the watchdog runs.
# SMS_PROVIDER is log (texts written to the log, none sent) or telnyx,
# which also needs TELNYX_API_KEY (secret), TELNYX_FROM_NUMBER (E.164),
# TELNYX_MESSAGING_PROFILE_ID and TELNYX_PUBLIC_KEY (webhook signatures).
SMS_PROVIDER=log
WATCHDOG_TICK_SECONDS=30
# The four Telnyx keys are set on the host only, never here: uncomment
# them in /srv/prd-stillthere/etc/prd-stillthere-api.env with the values
# from the Telnyx portal and set SMS_PROVIDER=telnyx (doc/320, Telnyx).
# TELNYX_API_KEY=SERVERONLY
# TELNYX_FROM_NUMBER=SERVERONLY
# TELNYX_MESSAGING_PROFILE_ID=SERVERONLY
# TELNYX_PUBLIC_KEY=SERVERONLY

# Inbound texts: Telnyx posts to https://webhook.teamtaggle.com/telnyx-inbound,
# which nginx (nginx_webhook.teamtaggle.com) hands to the SMS relay
# (prd-smsrelay, 127.0.0.1:8095), not to this API. The API reads its queue
# there: all three keys or none. SMS_RELAY_TOKEN is a secret, set on the
# host only (doc/320, SMS relay); the relay keeps only its SHA-256.
# SMS_RELAY_URL=http://127.0.0.1:8095
# SMS_RELAY_TOKEN=SERVERONLY
# SMS_RELAY_QUEUE=stillthere
