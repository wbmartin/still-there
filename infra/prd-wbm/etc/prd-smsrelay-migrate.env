# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:root, chmod 0600  (only root runs
# sms-relay migrate; the relay's user must not read the DDL password)
# smsrelay_ddl owns the schema (infra/sql/smsrelay-host-db.sql).
# The password is generated on this host:  openssl rand -hex 32
DATABASE_URL=postgres://smsrelay_ddl:SERVERONLY@127.0.0.1:5432/prd_smsrelay_db
