#!/bin/bash
# One-time, as root: move fail2ban's config to /srv/fail2ban/etc/ and leave
# symlinks behind, so /srv/fail2ban is the copy of record on the host and
# this repo can mirror it. Safe to re-run — a file already moved is skipped.
set -euo pipefail

mkdir -p /srv/fail2ban/{bin,etc}

move_and_link() {
  local live="$1" kept="/srv/fail2ban/etc/$2"
  if [ -L "$live" ]; then echo "[skip] $live is already a symlink"; return; fi
  if [ ! -e "$live" ]; then echo "[skip] $live does not exist"; return; fi
  mv "$live" "$kept"
  ln -s "$kept" "$live"
  echo "[ok]   $live -> $kept"
}

move_and_link /etc/fail2ban/fail2ban.local          fail2ban.local
move_and_link /etc/fail2ban/jail.local              jail.local
move_and_link /etc/fail2ban/filter.d/nginx-404.conf nginx-404.conf

fail2ban-client reload
