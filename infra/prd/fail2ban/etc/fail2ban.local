# Mirror of /srv/fail2ban/etc/fail2ban.local (symlinked from
# /etc/fail2ban/fail2ban.local). Host-level, not app-level: fail2ban runs
# once per server. Nothing secret here, so this copy is not redacted.
[Definition]
loglevel = INFO
logtarget = /var/log/fail2ban.log
socket = /var/run/fail2ban/fail2ban.sock
pidfile = /var/run/fail2ban/fail2ban.pid
dbfile = /var/lib/fail2ban/fail2ban.sqlite3
dbpurgeage = 1d
