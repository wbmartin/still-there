#!/bin/bash
# Nightly prod backup. Root, from cron; the schedule is NACK_CRON in
# shrmpl-etc/nack-monitors/prd-proto-backup-all_NACKID.env. Checks in with
# nackmon only on success.
#
#   database  pg_dump -Fc of DATABASE_NAME, pg_dumpall --globals-only (roles)
#   files     tar of /srv/$BACKUP_ENV without backup/ and stg/; carries etc/
#             (secrets), so BACKUP_DST is root-only 0700
#
# Retention is the weekday name: seven rolling copies here and in REMOTE_DIR
# on REMOTE_SERVER (an ssh alias in root's ~/.ssh/config).
set -euo pipefail

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ENV_FILE="$SRV_ROOT/etc/prd-proto-backup.env"
[ -r "$ENV_FILE" ] || { echo "[ERROR] $ENV_FILE missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$ENV_FILE"
for var in BACKUP_ENV BACKUP_ROOT REMOTE_SERVER REMOTE_DIR DATABASE_NAME HEALTHCHECK_URL; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $ENV_FILE"; exit 1; }
done

BACKUP_SRC=/srv/$BACKUP_ENV
BACKUP_DST=$BACKUP_ROOT/$BACKUP_ENV
BACKUP_ID=$(date +%a)
HOST_NAME=$(hostname)
PREFIX="$BACKUP_DST/$(echo "$BACKUP_ENV" | tr "[:lower:]" "[:upper:]")-BACKUP"
DB_BACKUP_FILE="$PREFIX-PG-$HOST_NAME-$DATABASE_NAME-$BACKUP_ID.dump"
DB_GLOBALS_FILE="$PREFIX-PG-$HOST_NAME-Globals-$BACKUP_ID.sql.gz"
FS_BACKUP_FILE="$PREFIX-FS-$HOST_NAME-$BACKUP_ID.tar.gz"

mkdir -p "$BACKUP_DST"
chmod 0700 "$BACKUP_DST"

echo "[INFO] Database: $DATABASE_NAME -> $DB_BACKUP_FILE"
# Root's shell opens the output files; only pg_dump runs as postgres.
# shellcheck disable=SC2024
sudo -u postgres pg_dump -Fc "$DATABASE_NAME" > "$DB_BACKUP_FILE"
sudo -u postgres pg_dumpall --globals-only | gzip > "$DB_GLOBALS_FILE"

echo "[INFO] Filesystem: $BACKUP_SRC -> $FS_BACKUP_FILE"
rc=0
# tar exit 1 = a file changed while reading, which a live log directory does.
tar -C "$BACKUP_SRC" --exclude=./backup --exclude=./stg \
    -czf "$FS_BACKUP_FILE" . || rc=$?
(( rc <= 1 )) || exit "$rc"

echo "[INFO] Shipping to $REMOTE_SERVER:$REMOTE_DIR"
scp -q "$DB_BACKUP_FILE" "$DB_GLOBALS_FILE" "$FS_BACKUP_FILE" \
    "$REMOTE_SERVER:$REMOTE_DIR/"

curl -fsS "$HEALTHCHECK_URL" > /dev/null
echo "[INFO] Backup complete"
