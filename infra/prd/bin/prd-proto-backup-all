#!/bin/bash
set -euo pipefail

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ENV_FILE="$SRV_ROOT/etc/prd-proto-backup.env"
[ -r "$ENV_FILE" ] || { echo "[ERROR] $ENV_FILE missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$ENV_FILE"
for var in BACKUP_ENV BACKUP_ROOT REMOTE_SERVER DATABASE_NAME HEALTHCHECK_URL; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $ENV_FILE"; exit 1; }
done

BACKUP_SRC=/srv/$BACKUP_ENV
BACKUP_DST=$BACKUP_ROOT/$BACKUP_ENV
BACKUP_ID=$(date +%a)
HOST_NAME=$(hostname)
PREFIX="$BACKUP_DST/$(echo "$BACKUP_ENV" | tr "[:lower:]" "[:upper:]")-BACKUP"
FS_BACKUP_FILE="$PREFIX-FS-$HOST_NAME-$BACKUP_ID.tar.gz"
DB_BACKUP_FILE="$PREFIX-PG-$HOST_NAME-$DATABASE_NAME-$BACKUP_ID.dump.gz"
DB_GLOBALS_FILE="$PREFIX-PG-$HOST_NAME-Globals-$BACKUP_ID.dump.gz"

mkdir -p "$BACKUP_DST"

echo "[INFO] Filesystem: $BACKUP_SRC -> $FS_BACKUP_FILE"
cd "$BACKUP_SRC"
rc=0
# tar exit 1 = a file changed while reading, which a live log directory does.
tar -czf "$FS_BACKUP_FILE" . || rc=$?
(( rc <= 1 )) || exit "$rc"
scp -q "$FS_BACKUP_FILE" "$REMOTE_SERVER:~/"

echo "[INFO] Database: $DATABASE_NAME -> $DB_BACKUP_FILE"
su - postgres -c "pg_dump -Fc $DATABASE_NAME | gzip > $DB_BACKUP_FILE"
su - postgres -c "pg_dumpall --globals-only | gzip > $DB_GLOBALS_FILE"
su - postgres -c "psql -d $DATABASE_NAME -c 'VACUUM;'"
scp -q "$DB_BACKUP_FILE" "$REMOTE_SERVER:~/"
scp -q "$DB_GLOBALS_FILE" "$REMOTE_SERVER:~/"

curl -fsS "$HEALTHCHECK_URL" > /dev/null
echo "[INFO] Backup complete"
