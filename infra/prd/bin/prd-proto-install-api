#!/bin/bash
set -euo pipefail

# Run by hand as root, it re-runs as the hook user, so the files it writes
# stay writable by the next webhook build.
TARGET_USER="shrmpl-hook"
if [ "$(id -un)" != "$TARGET_USER" ]; then
    exec sudo -u "$TARGET_USER" -H "$0" "$@"
fi

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The app root is /srv/<env>-<slug>: every env, unit and script name comes
# from it, so this file is the same on every host.
APP_ENV="$(basename "$SRV_ROOT")"
DEPLOY_ENV="$SRV_ROOT/etc/$APP_ENV-deploy.env"
[ -r "$DEPLOY_ENV" ] || { echo "[ERROR] $DEPLOY_ENV missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
for var in CONTAINER_REGISTRY_SERVER CONTAINER_REGISTRY_USER CONTAINER_REGISTRY_PASSWORD SERVICE HEALTH_URL DEPLOY_TAG; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $DEPLOY_ENV"; exit 1; }
done
API_BLOB="$CONTAINER_REGISTRY_SERVER/deploy/blobs/proto-api"

TAG="${1:-$DEPLOY_TAG}"

RESTART_TRIGGER="$SRV_ROOT/stg/restart.request"

PULL_DIR="$SRV_ROOT/stg/pull.$$"
mkdir -p "$PULL_DIR"
trap 'rm -rf "$PULL_DIR"' EXIT

echo "[INFO] Pulling $API_BLOB:$TAG"
echo "$CONTAINER_REGISTRY_PASSWORD" | oras login -u "$CONTAINER_REGISTRY_USER" --password-stdin "$CONTAINER_REGISTRY_SERVER"
oras pull "$API_BLOB:$TAG" --output "$PULL_DIR"
[ -s "$PULL_DIR/proto-api" ] || { echo "[ERROR] $TAG contained no proto-api"; exit 1; }

mkdir -p "$SRV_ROOT/libexec"
# Migrations run BEFORE the API binary is swapped; a failure leaves the old binary running.
MIGRATE_ENV="$SRV_ROOT/etc/$APP_ENV-migrate.env"
if [ -s "$PULL_DIR/proto-migrate" ]; then
    [ -r "$MIGRATE_ENV" ] || { echo "[ERROR] $MIGRATE_ENV missing or unreadable"; exit 1; }
    install -m 0755 "$PULL_DIR/proto-migrate" "$SRV_ROOT/libexec/proto-migrate.new"
    mv -f "$SRV_ROOT/libexec/proto-migrate.new" "$SRV_ROOT/libexec/proto-migrate"
    echo "[INFO] Installed proto-migrate from $TAG"
    MIGRATE="$SRV_ROOT/libexec/proto-migrate -config $MIGRATE_ENV"
    echo "[INFO] migrate verify"
    $MIGRATE verify
    PENDING=$($MIGRATE pending)
    if [ "$PENDING" != "0" ]; then
        DUMP="$SRV_ROOT/backup/pre-migrate-$(date -u +%Y%m%dT%H%M%SZ).dump"
        mkdir -p "$SRV_ROOT/backup"
        echo "[INFO] $PENDING migration(s) pending; dumping to $DUMP first"
        pg_dump -Fc "$(sed -n 's/^DATABASE_URL=//p' "$MIGRATE_ENV")" > "$DUMP"
        echo "[INFO] migrate up"
        $MIGRATE up
    else
        echo "[INFO] migrate: nothing pending"
    fi
else
    echo "[WARN] $TAG carries no proto-migrate; schema left as is"
fi

echo "[INFO] Installing $TAG"
# ORAS drops the exec bit; install+mv keeps the swap atomic.
install -m 0755 "$PULL_DIR/proto-api" "$SRV_ROOT/libexec/proto-api.new"
mv -f "$SRV_ROOT/libexec/proto-api.new" "$SRV_ROOT/libexec/proto-api"
{
    [ -f "$PULL_DIR/proto-api.revision" ] && cat "$PULL_DIR/proto-api.revision"
    printf 'installed_tag=%s\ninstalled_at=%s\n' "$TAG" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$SRV_ROOT/libexec/proto-api.revision"

echo "[INFO] Requesting restart of $SERVICE"
pid_before=$(systemctl show -p MainPID --value "$SERVICE" 2>/dev/null || echo "")
# The restart.path unit restarts the service when this file appears.
: > "$RESTART_TRIGGER"

restarted=""
for _ in $(seq 1 30); do
    pid_now=$(systemctl show -p MainPID --value "$SERVICE" 2>/dev/null || echo "")
    if [ -n "$pid_now" ] && [ "$pid_now" != "0" ] && [ "$pid_now" != "$pid_before" ]; then
        restarted=yes
        break
    fi
    sleep 1
done

if [ -z "$restarted" ]; then
    echo "[ERROR] $SERVICE did not restart within 30s."
    echo "        The trigger file is still at $RESTART_TRIGGER, which means the"
    echo "        path unit is not running. Check:"
    echo "          systemctl status $APP_ENV-restart.path"
    exit 1
fi

for _ in $(seq 1 15); do
    if curl -fsS --max-time 2 "$HEALTH_URL" 2>/dev/null | grep -q '"status":"ok"'; then
        echo "[INFO] $SERVICE healthy"
        [ -f "$SRV_ROOT/libexec/proto-api.revision" ] && cat "$SRV_ROOT/libexec/proto-api.revision"
        exit 0
    fi
    sleep 1
done

echo "[ERROR] $SERVICE restarted but did not report healthy within 15s."
echo "        journalctl -u $SERVICE -n 40 --no-pager"
exit 1
