#!/bin/bash
# Issues / renews the site's Let's Encrypt certificate and copies it to
# crt/<site>/, which the nginx site reads. Root, from cron; the schedule is
# NACK_CRON in shrmpl-etc/nack-monitors/prd-proto-renew-web-certs_NACKID.env.
# Checks in with nackmon only on success. Run it once by hand before linking
# the nginx site, which fails nginx -t until the pem files exist.
# --agree-tos -n: cron has no terminal for the ToS prompt.
# --force-renewal: a monthly reissue, so a failure is never mistaken for
# "not due yet".
set -euo pipefail
export PATH=/usr/sbin:$PATH

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DEPLOY_ENV="$SRV_ROOT/etc/prd-proto-deploy.env"
[ -r "$DEPLOY_ENV" ] || { echo "[ERROR] $DEPLOY_ENV missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
for var in SITE_NAME CERTBOT_EMAIL CERT_HEALTHCHECK_URL; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $DEPLOY_ENV"; exit 1; }
done
LIVE_DIR="/etc/letsencrypt/live/$SITE_NAME"
CRT_DIR="$SRV_ROOT/crt/$SITE_NAME"

echo "[INFO] certbot for $SITE_NAME"
/usr/bin/certbot --nginx certonly -d "$SITE_NAME" --email "$CERTBOT_EMAIL" \
    --agree-tos -n --force-renewal

# The nginx master reads both files as root; www-data never needs the key.
install -d -o root -g www-data -m 0750 "$CRT_DIR"
install -o root -g www-data -m 0640 "$LIVE_DIR/fullchain.pem" "$CRT_DIR/"
install -o root -g root -m 0600 "$LIVE_DIR/privkey.pem" "$CRT_DIR/"

nginx -t
systemctl reload nginx
curl -fsS "$CERT_HEALTHCHECK_URL" > /dev/null
echo "[INFO] $SITE_NAME renewed; nginx reloaded; nackmon checked in"
