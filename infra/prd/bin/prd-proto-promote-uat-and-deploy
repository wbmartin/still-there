#!/bin/bash

set -euo pipefail

TARGET_USER="shrmpl-hook"
if [ "$(id -un)" != "$TARGET_USER" ]; then
    echo "[ERROR] Must run as $TARGET_USER (currently $(id -un))."
    echo "        sudo -u $TARGET_USER -H $0 $*"
    exit 1
fi

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DEPLOY_ENV="$SRV_ROOT/etc/prd-proto-deploy.env"
[ -r "$DEPLOY_ENV" ] || { echo "[ERROR] $DEPLOY_ENV missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
for var in CONTAINER_REGISTRY_SERVER CONTAINER_REGISTRY_USER CONTAINER_REGISTRY_PASSWORD SERVICE DEPLOY_TAG SLACK_WEBHOOK; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $DEPLOY_ENV"; exit 1; }
done
API_BLOB="$CONTAINER_REGISTRY_SERVER/deploy/blobs/proto-api"
WEB_BLOB="$CONTAINER_REGISTRY_SERVER/deploy/blobs/proto-web"
DEPLOY_BIN="$SRV_ROOT/bin"
TARGET_TAG="$DEPLOY_TAG"

notify_failure() {
    local exit_code=$?
    [ "$exit_code" -eq 0 ] && return 0
    curl -fsS -X POST -H 'Content-Type: application/json' \
      --data "$(jq -n --arg text ":x: proto PROD promote FAILED on $(hostname) (exit $exit_code). Service state: $(systemctl is-active "$SERVICE" 2>/dev/null || echo unknown)" '{text: $text}')" \
      "$SLACK_WEBHOOK" > /dev/null || true
}
trap notify_failure EXIT

# Never rebuilds: retags the UAT digests, then installs exactly those bytes.
"$DEPLOY_BIN/prd-proto-promote-uat" "$@"

"$DEPLOY_BIN/prd-proto-install-api"
"$DEPLOY_BIN/prd-proto-publish-web-client" --pull "$TARGET_TAG"

# Past the point where a failure needs reporting.
trap - EXIT

REVISION_FILE="$SRV_ROOT/libexec/proto-api.revision"
COMMIT=$(sed -n 's/^commit=//p' "$REVISION_FILE" 2>/dev/null || true)
SUMMARY=":rocket: proto PROD deployed on $(hostname)"$'\n'"api: ${API_BLOB}:sha-${COMMIT:-unknown}"$'\n'"web: ${WEB_BLOB}:sha-${COMMIT:-unknown}"$'\n'"commit: ${COMMIT:-unknown}"

echo "[INFO] $SUMMARY"
SLACK_RESPONSE=$(curl -sS -X POST -H 'Content-Type: application/json' --data "$(jq -n --arg text "$SUMMARY" '{text: $text}')" "$SLACK_WEBHOOK" 2>&1) || true
echo "[INFO] slack: ${SLACK_RESPONSE:-no response}"

echo "[INFO] FINISHED"
exit 0
