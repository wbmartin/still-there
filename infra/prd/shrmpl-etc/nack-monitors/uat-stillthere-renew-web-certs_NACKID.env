# Note this repo file is a redacted copy of the server file
# (/srv/shrmpl/etc/nack-monitors/). NACKID in the filename is the check-in
# code; the server file is named uat-stillthere-renew-web-certs_<nackid>.env.
# The job curls the check-in on success as CERT_HEALTHCHECK_URL from
# etc/uat-stillthere-deploy.env (uat-stillthere-renew-web-certs).
# UAT's monitor, kept on the monitoring host (prd here), never on UAT: a
# monitor on the host it watches cannot report that host down.
NACK_CRON=30 3 3 * *
NACK_DESCRIPTION=UAT Proto cert renewal
NACK_GRACE_MIN=15
NACK_ESCALATION_GRACE_MIN=240

NACK_SLACK_WEBHOOK=https://hooks.slack.com/services/SERVERONLY
