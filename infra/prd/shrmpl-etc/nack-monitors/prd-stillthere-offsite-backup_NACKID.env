# Note this repo file is a redacted copy of the server file
# (/srv/shrmpl/etc/nack-monitors/). NACKID in the filename is the check-in
# code; the server file is named prd-stillthere-offsite-backup_<nackid>.env.
# The job curls the check-in on success as OFFSITE_HEALTHCHECK_URL from
# etc/prd-stillthere-offsite.env (prd-stillthere-offsite-backup, last lines).
NACK_CRON=30 8 * * 0,3
NACK_DESCRIPTION=Prod Proto off-site backup (B2)
NACK_GRACE_MIN=30
NACK_ESCALATION_GRACE_MIN=240

NACK_SLACK_WEBHOOK=https://hooks.slack.com/services/SERVERONLY
