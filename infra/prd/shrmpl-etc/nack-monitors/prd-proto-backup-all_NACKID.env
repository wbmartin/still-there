# Note this repo file is a redacted copy of the server file
# (/srv/shrmpl/etc/nack-monitors/). NACKID in the filename is the check-in
# code; the server file is named prd-proto-backup-all_<nackid>.env.
# The job curls the check-in on success as HEALTHCHECK_URL from
# etc/prd-proto-backup.env (prd-proto-backup-all, last line).
NACK_CRON=30 7 * * *
NACK_DESCRIPTION=Prod Proto backup
NACK_GRACE_MIN=15
NACK_ESCALATION_GRACE_MIN=60

NACK_SLACK_WEBHOOK=https://hooks.slack.com/services/SERVERONLY
