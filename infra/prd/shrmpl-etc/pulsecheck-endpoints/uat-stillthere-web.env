# Note this repo file is a redacted copy of the server file
# (/srv/shrmpl/etc/pulsecheck-endpoints/). Hostnames are example.com here;
# the host copy carries the real site name (SITE_NAME in the matching
# etc/<env>-stillthere-deploy.env).
# UAT's monitor, kept on the monitoring host (prd here), never on UAT: a
# monitor on the host it watches cannot report that host down.
PULSE_URL=https://uat-stillthere.example.com
PULSE_INTERVAL_SEC=180
PULSE_EXPECT_STATUS=200
PULSE_ESCALATION_MIN=30

PULSE_SLACK_WEBHOOK=https://hooks.slack.com/services/SERVERONLY
