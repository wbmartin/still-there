# /srv/prd-stillthere/etc/prd-stillthere-restart.path, symlinked from
# /etc/systemd/system/ (infra/README.md). Runs as root: the hook user
# only touches stg/restart.request.
[Unit]
Description=Watch for a stillthere-api restart request

[Path]
PathExists=/srv/prd-stillthere/stg/restart.request
Unit=prd-stillthere-restart.service

[Install]
WantedBy=multi-user.target
