# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:root, chmod 0600  (backup-all runs as root, from cron)

BACKUP_ENV=prd-proto
BACKUP_ROOT=/backup
REMOTE_SERVER=SERVERONLY
# Directory on REMOTE_SERVER that receives the files; it gets etc/ secrets.
REMOTE_DIR=SERVERONLY
DATABASE_NAME=prd_proto_db
HEALTHCHECK_URL=SERVERONLY
