# /srv/prd-proto/etc/prd-proto-restart.service, symlinked from
# /etc/systemd/system/ (infra/README.md). Runs as root: the hook user
# only touches stg/restart.request.
[Unit]
Description=Restart proto-api on request

[Service]
Type=oneshot
ExecStart=/bin/rm -f /srv/prd-proto/stg/restart.request
ExecStart=/bin/systemctl restart prd-proto-api
