# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:root, chmod 0600  (offsite-backup runs as root, from cron)

# restic repository in the B2 bucket, over B2's S3-compatible API (restic's
# recommended way to reach B2): s3:https://<bucket endpoint>/<bucket>/<path>.
RESTIC_REPOSITORY=s3:https://s3.SERVERONLY.backblazeb2.com/SERVERONLY/prd-stillthere
# B2 application key restricted to that bucket: keyID and applicationKey.
AWS_ACCESS_KEY_ID=SERVERONLY
AWS_SECRET_ACCESS_KEY=SERVERONLY
# Encrypts everything on this host before it is sent (openssl rand -hex 32).
# Keep a copy off this host too: without it the off-site copies are unreadable.
RESTIC_PASSWORD=SERVERONLY
# Snapshots kept in B2 (two runs a week: the last Sunday and Wednesday).
KEEP_LAST=2
OFFSITE_HEALTHCHECK_URL=SERVERONLY
