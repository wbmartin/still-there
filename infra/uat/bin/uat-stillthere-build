#!/bin/bash
# The UAT build, run by the webhook on a push to BRANCH_TO_CHECKOUT: build,
# push, install and publish the head commit, Slack "deployed", then run the
# test gate against that deployed commit. A red suite does not undo the
# deploy (UAT is where a change gets looked at); it withholds the registry
# tag sha-<commit>-passed, without which prd-stillthere-promote-uat refuses the
# commit. A deploy failure exits 1 and names its step; a test failure is
# Slacked ("don't promote") and exits 0.

set -euo pipefail

TARGET_USER="shrmpl-hook"
if [ "$(id -un)" != "$TARGET_USER" ]; then
    exec sudo -u "$TARGET_USER" -H "$0" "$@"
fi

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The app root is /srv/<env>-<slug>: every env, unit and script name comes
# from it, so this file is the same on every host.
APP_ENV="$(basename "$SRV_ROOT")"
DEPLOY_ENV="$SRV_ROOT/etc/$APP_ENV-deploy.env"
[ -r "$DEPLOY_ENV" ] || { echo "[ERROR] $DEPLOY_ENV missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
for var in CONTAINER_REGISTRY_SERVER CONTAINER_REGISTRY_USER CONTAINER_REGISTRY_PASSWORD SERVICE DEPLOY_TAG SLACK_WEBHOOK BRANCH_TO_CHECKOUT REPO_URL BUILD_STG; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $DEPLOY_ENV"; exit 1; }
done
API_BLOB="$CONTAINER_REGISTRY_SERVER/deploy/blobs/stillthere-api"
WEB_BLOB="$CONTAINER_REGISTRY_SERVER/deploy/blobs/stillthere-web"
SRV_BIN=$SRV_ROOT/bin

slack() {
    curl -fsS -X POST -H 'Content-Type: application/json' \
        --data "$(jq -n --arg text "$1" '{text: $text}')" \
        "$SLACK_WEBHOOK" > /dev/null || true
}

# Every failure from here on is reported with the step it died in and the
# full commit (what the registry tag sha-<commit> and stillthere-api.revision
# carry; never a short sha). Before install the service is untouched; from
# the tests on it runs this commit. A red suite is not a failure here: it
# is reported after the run, below.
STEP="build lock"
GIT_SHA="?"
notify_failure() {
    local exit_code=$?
    [ "$exit_code" -eq 0 ] && return 0
    local state
    state="$(systemctl is-active "$SERVICE" 2>/dev/null || echo unknown)"
    case "$STEP" in
        install*|"web publish")
            state="$state; it may already run this commit, see the hook log" ;;
        tests|"passed tag")
            state="$state on this commit, which is NOT promotable (no"
            state+=" sha-$GIT_SHA-passed tag)" ;;
        *)  state="$state, still on the previous build" ;;
    esac
    local message=":x: $APP_ENV build FAILED at *$STEP* (exit $exit_code)"
    message+=" -- commit $GIT_SHA on $(hostname). $SERVICE is $state."
    slack "$message"
}
trap notify_failure EXIT

# A push that lands during a build waits for it instead of being dropped
# (the running build checked out the head before this push existed).
# HOOK_TIMEOUT (shrmpl-etc/hooks) allows for one build queued behind one.
LOCK_FILE="/var/lock/$APP_ENV-build.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    echo "[INFO] Another build is running; waiting for it (lock: $LOCK_FILE)"
    flock -w 1800 200 || {
        echo "[ERROR] $LOCK_FILE still held after 30 min"; exit 1
    }
fi

echo "[INFO] Starting Build Script / Setting Vars"
STEP="preflight"

# The host's packaged Go may be older than src/api-srv/go.mod; let it fetch
# the toolchain go.mod names (and staticcheck's, in the test gate) into
# shrmpl-hook's module cache. Checked by name after the checkout.
export GOTOOLCHAIN=auto

# git: checkout; psql: the test gate (PSQL in the test env); pg_dump:
# install-api's pre-migrate dump.
for tool in go npm oras jq git psql pg_dump; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "[ERROR] $tool is not installed or not on PATH for $TARGET_USER."
        exit 1
    }
done

for dir in "$SRV_ROOT" "$SRV_ROOT/stg" "$SRV_ROOT/libexec" "$SRV_ROOT/backup"; do
    mkdir -p "$dir" 2>/dev/null || true
    [ -w "$dir" ] || {
        echo "[ERROR] $dir is not writable by $TARGET_USER (infra/README.md step 1)."
        if [ "$dir" = "$SRV_ROOT" ]; then
            echo "        chown root:$TARGET_USER $dir && chmod 1775 $dir"
        else
            echo "        chown -R $TARGET_USER:$TARGET_USER $dir"
        fi
        exit 1
    }
done
[ -w "$BUILD_STG" ] || {
    echo "[ERROR] checkout $BUILD_STG missing or not writable by" \
        "$TARGET_USER (infra/README.md step 1)."
    echo "        chown -R $TARGET_USER:$TARGET_USER $BUILD_STG"
    exit 1
}

echo "[INFO] Refreshing git repo"
STEP="checkout"
pushd "$BUILD_STG" > /dev/null
git fetch origin
git checkout "$BRANCH_TO_CHECKOUT"
git reset --hard "origin/$BRANCH_TO_CHECKOUT"

GIT_SHA=$(git rev-parse "origin/$BRANCH_TO_CHECKOUT")
SUBJECT=$(git log -1 --format=%s | cut -c1-90)
echo "[INFO] Building from commit $GIT_SHA ($BRANCH_TO_CHECKOUT)"
STARTED=":hammer_and_wrench: $APP_ENV build started -- $GIT_SHA"
slack "$STARTED on $BRANCH_TO_CHECKOUT: $SUBJECT"

# Fails here, by name, rather than as a compile error minutes in: a host Go
# too old to switch toolchains, or a toolchain fetch that cannot reach the
# proxy.
STEP="go toolchain"
NEED_GO="$(sed -n 's/^go //p' "$BUILD_STG/src/api-srv/go.mod")"
HAVE_GO="$(cd "$BUILD_STG/src/api-srv" && go env GOVERSION)"
if [ "$(printf '%s\n' "go$NEED_GO" "$HAVE_GO" | sort -V | head -1)" \
        != "go$NEED_GO" ]; then
    echo "[ERROR] src/api-srv/go.mod needs go $NEED_GO;" \
        "$TARGET_USER gets $HAVE_GO (GOTOOLCHAIN=auto)"
    exit 1
fi
echo "[INFO] $HAVE_GO (src/api-srv/go.mod needs go $NEED_GO)"

echo "[INFO] Building Go API"
STEP="go build"
mkdir -p "$SRV_ROOT/stg"
pushd "$BUILD_STG/src/api-srv" > /dev/null

# Static binaries (CGO_ENABLED=0). The migrator ships with the API; install-api runs it before swapping the binary.
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o "$SRV_ROOT/stg/api-srv" ./cmd/server
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o "$SRV_ROOT/stg/stillthere-migrate" ./cmd/migrate
[ -s "$SRV_ROOT/stg/api-srv" ] && [ -s "$SRV_ROOT/stg/stillthere-migrate" ] || { echo "[ERROR] go build produced no binaries"; exit 1; }
popd > /dev/null

printf 'commit=%s\nbranch=%s\nbuilt=%s\nhost=%s\n' \
    "$GIT_SHA" "$BRANCH_TO_CHECKOUT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)" \
    > "$SRV_ROOT/stg/stillthere-api.revision"

if "$SRV_ROOT/stg/api-srv" >/dev/null 2>&1; then
    echo "[WARN] API exited 0 with no config argument; expected the usage path."
fi

WEB_TARBALL="stillthere-web-client.tar.gz"

echo "[INFO] Building web client"
STEP="web build"
pushd "$BUILD_STG/src/web-app" > /dev/null
npm ci
VITE_APP_VERSION="$GIT_SHA" npm run build   # stamps the commit into the bundle (issue reports carry it)
popd > /dev/null

if [ ! -d "$BUILD_STG/src/web-app/dist" ]; then
    echo "[ERROR] src/web-app/dist not found after build"; exit 1
fi
if [ ! -f "$BUILD_STG/src/web-app/dist/index.html" ]; then
    echo "[ERROR] src/web-app/dist/index.html missing -- refusing to ship an empty bundle"; exit 1
fi

(cd "$BUILD_STG/src/web-app/dist" && tar -czf "$SRV_ROOT/stg/$WEB_TARBALL" -- *)

echo "[INFO] Logging in to registry"
STEP="registry push"
echo "$CONTAINER_REGISTRY_PASSWORD" | oras login -u "$CONTAINER_REGISTRY_USER" --password-stdin "$CONTAINER_REGISTRY_SERVER"

pushd "$SRV_ROOT/stg" > /dev/null
oras push "$API_BLOB:sha-$GIT_SHA" \
    "api-srv:application/vnd.stillthere.deploy.layer.v1+binary" \
    "stillthere-migrate:application/vnd.stillthere.deploy.layer.v1+binary" \
    "stillthere-api.revision:text/plain" \
    --annotation "org.opencontainers.image.description=stillthere-api linux/amd64" \
    --annotation "org.opencontainers.image.revision=$GIT_SHA" \
    --annotation "org.opencontainers.image.source=$REPO_URL"
oras tag "$API_BLOB:sha-$GIT_SHA" "$DEPLOY_TAG"

oras push "$WEB_BLOB:sha-$GIT_SHA" \
    "$WEB_TARBALL:application/vnd.stillthere.deploy.layer.v1+tar" \
    --annotation "org.opencontainers.image.title=$WEB_TARBALL" \
    --annotation "org.opencontainers.image.description=server-deploy-package" \
    --annotation "org.opencontainers.image.revision=$GIT_SHA" \
    --annotation "org.opencontainers.image.source=$REPO_URL"
oras tag "$WEB_BLOB:sha-$GIT_SHA" "$DEPLOY_TAG"
popd > /dev/null

popd > /dev/null

echo "[INFO] Starting server deploy process"
STEP="install (migrate, swap, restart, health)"
"$SRV_BIN/$APP_ENV-install-api"
STEP="web publish"
"$SRV_BIN/$APP_ENV-publish-web-client"

SUMMARY=":rocket: $APP_ENV deployed on $(hostname) -- $SUBJECT"
SUMMARY+=$'\n'"api: ${API_BLOB}:sha-${GIT_SHA}"
SUMMARY+=$'\n'"web: ${WEB_BLOB}:sha-${GIT_SHA}"
SUMMARY+=$'\n'"commit: ${GIT_SHA}"
SUMMARY+=$'\n'"tests: running now; not promotable until they pass"
echo "[INFO] $SUMMARY"
SLACK_RESPONSE=$(curl -sS -X POST -H 'Content-Type: application/json' --data "$(jq -n --arg text "$SUMMARY" '{text: $text}')" "$SLACK_WEBHOOK" 2>&1) || true
echo "[INFO] slack: ${SLACK_RESPONSE:-no response}"

# The checkout's own gate (bin/300-run-tests all) against the commit UAT
# now runs. Its one-line result (counts; on red the step, failing tests
# and log) goes to Slack either way.
echo "[INFO] Testing the deployed commit $GIT_SHA"
STEP="tests"
RESULT_FILE="$SRV_ROOT/stg/run-tests.result"
rm -f "$RESULT_FILE"
TEST_STATUS=0
"$SRV_BIN/$APP_ENV-run-tests" || TEST_STATUS=$?
RESULT="$(cat "$RESULT_FILE" 2>/dev/null || true)"
RESULT="${RESULT:-no result file, see the hook log}"
echo "[INFO] tests: $RESULT"

if [ "$TEST_STATUS" -ne 0 ]; then
    trap - EXIT
    MESSAGE=":x: $APP_ENV tests FAILED on the deployed commit $GIT_SHA"
    MESSAGE+=" (exit $TEST_STATUS) on $(hostname): $RESULT"
    MESSAGE+=$'\n'"UAT runs it; the deploy stands. Don't promote:"
    MESSAGE+=" prd-stillthere-promote-uat refuses a commit with no"
    MESSAGE+=" sha-<commit>-passed tag."
    slack "$MESSAGE"
    echo "[INFO] Finished (deployed; tests FAILED)"
    exit 0
fi

# The mark promote checks. By tag name: the build lock keeps another build
# of this commit from moving sha-$GIT_SHA since the push above.
STEP="passed tag"
PASSED_TAG="sha-$GIT_SHA-passed"
oras tag "$API_BLOB:sha-$GIT_SHA" "$PASSED_TAG"
oras tag "$WEB_BLOB:sha-$GIT_SHA" "$PASSED_TAG"
trap - EXIT

MESSAGE=":white_check_mark: $APP_ENV tests passed on $GIT_SHA: $RESULT"
MESSAGE+=$'\n'"promotable: tagged $PASSED_TAG"
slack "$MESSAGE"
echo "[INFO] Finished (deployed; tests passed; tagged $PASSED_TAG)"
exit 0
