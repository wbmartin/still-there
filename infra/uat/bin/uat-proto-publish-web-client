#!/bin/bash
# Swaps web-pub/ by renaming entries in the app root, so the root must be
# root:shrmpl-hook 1775 (infra/README.md step 1): group write lets the hook
# create and rename, and the sticky bit limits it to entries it owns.
set -euo pipefail

SRV_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DEPLOY_ENV="$SRV_ROOT/etc/uat-proto-deploy.env"
[ -r "$DEPLOY_ENV" ] || { echo "[ERROR] $DEPLOY_ENV missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
for var in CONTAINER_REGISTRY_SERVER CONTAINER_REGISTRY_USER CONTAINER_REGISTRY_PASSWORD DEPLOY_TAG; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $DEPLOY_ENV"; exit 1; }
done
WEB_BLOB="$CONTAINER_REGISTRY_SERVER/deploy/blobs/proto-web"

STG_DIR="$SRV_ROOT/stg"
WEB_PUB_DIR="$SRV_ROOT/web-pub"
TARBALL="proto-web-client.tar.gz"

TARGET_USER="shrmpl-hook"
if [ "$(id -un)" != "$TARGET_USER" ]; then
    echo "[ERROR] Must run as $TARGET_USER (currently $(id -un))."
    echo "        sudo -u $TARGET_USER -H $0 $*"
    exit 1
fi

if [ "${1:-}" = "--pull" ]; then
    TAG="${2:-$DEPLOY_TAG}"
    echo "[INFO] Pulling $WEB_BLOB:$TAG"
    echo "$CONTAINER_REGISTRY_PASSWORD" | oras login -u "$CONTAINER_REGISTRY_USER" --password-stdin "$CONTAINER_REGISTRY_SERVER"
    mkdir -p "$STG_DIR"
    oras pull "$WEB_BLOB:$TAG" --output "$STG_DIR"
fi

SOURCE="$STG_DIR/$TARBALL"
if [ ! -f "$SOURCE" ]; then
    echo "[ERROR] Tarball not found at $SOURCE"
    echo "        Run the build, or re-run with --pull <tag>."
    exit 1
fi

STAGE_DIR="$WEB_PUB_DIR.incoming.$$"
OLD_DIR="$WEB_PUB_DIR.old.$$"
rm -rf "$STAGE_DIR"
mkdir -p "$STAGE_DIR"
tar --no-same-owner -xzf "$SOURCE" -C "$STAGE_DIR"

if [ ! -f "$STAGE_DIR/index.html" ]; then
    echo "[ERROR] Extracted bundle has no index.html -- refusing to publish"
    rm -rf "$STAGE_DIR"
    exit 1
fi

# Readable by nginx before it goes live, not after.
chmod -R a+rX "$STAGE_DIR"
mkdir -p "$WEB_PUB_DIR"
mv "$WEB_PUB_DIR" "$OLD_DIR"
mv "$STAGE_DIR" "$WEB_PUB_DIR"
rm -rf "$OLD_DIR"

echo "[INFO] Web client published to $WEB_PUB_DIR"
exit 0
