# Mirror of /srv/fail2ban/etc/jail.local (symlinked from
# /etc/fail2ban/jail.local). Host-level, not app-level: fail2ban runs once
# per server and this one file lists every jail on it.
#
# Convention: ONE JAIL PER APP, named after the app's /srv/<app> directory
# and pointed at that app's own nginx access log. This repo owns the
# [uat-proto] jail at the bottom. On a shared host the live file is the
# union of the jails each app's repo owns -- when another app is added,
# its lines come from its repo, not from here, and this copy gains them
# too so the mirror stays honest.
#
# ignoreip holds the operator's source address and is redacted.

[INCLUDES]
before = paths-debian.conf

[DEFAULT]
ignorecommand =
ignoreip = 127.0.0.1/8 ::1 SERVERONLY
bantime  = 10m
backend = auto
usedns = warn
logencoding = auto
enabled = false
mode = normal
filter = %(__name__)s[mode=%(mode)s]

# Default protocol
protocol = tcp

# Chain that ban actions expecting a chain parameter jump from
chain = <known/chain>

# Ports to be banned; overridden per jail
port = 0:65535

# Format of user-agent https://tools.ietf.org/html/rfc7231#section-5.5.3
fail2ban_agent = Fail2Ban/%(fail2ban_version)s

#
# JAILS
#

findtime = 60
maxretry = 20
banaction = ufw

[sshd]
enabled = true

[uat-proto]
enabled = true
port    = http,https
filter  = nginx-404
logpath = /srv/uat-proto/log/nginx_access.log
