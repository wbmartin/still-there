# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:proto, chmod 0640
#
# The API's DML role (db_reader + db_writer only). The migrator connects as
# proto_ddl from uat-proto-migrate.env; the API must never own the schema.
# Vault disabled: no VAULT_* keys, so the three secrets below are read inline.

DATABASE_URL=postgres://uat_proto_user:SERVERONLY@127.0.0.1:5432/uat_proto_db
JWT_SECRET=SERVERONLY
TOTP_ENCRYPTION_KEY=SERVERONLY

JWT_SESSION_EXPIRE_HOURS=72

FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

MAX_USER_REQ_PER_MIN=200
MAX_UNAUTH_REQ_PER_MIN=20

CORS_ALLOWED_ORIGINS=https://uat-proto.example.com

KV_BACKEND=memory
# KV_HOST_PORT=127.0.0.1:7171          # only when KV_BACKEND=shrmpl
# LOG_RECEIVER_HOST_PORT=127.0.0.1:7379  # unset = stdout/journald only

APP_NAME="Proto App"
SERVER_NAME=uat-proto-api

ENABLE_TLS=false
SERVER_PORT=8088
SERVER_BIND_ADDRESS=127.0.0.1
