# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:shrmpl-hook, chmod 0640
#
# etc/e2e-api-srv.env for the build host: the harness API instance, loopback
# only, scratch database, throwaway secrets. Ports 8082/5182 must be free.

DATABASE_URL=postgres://proto_ci:SERVERONLY@127.0.0.1:5432/uat_proto_e2e_db

# Throwaway harness values, not secrets, so they stay in this copy.
# TOTP_ENCRYPTION_KEY must be 32 bytes as hex (AES-256): this one is
# "uat-e2e-only-totp-key-not-deploy" hex-encoded.
JWT_SECRET=e2e-only-jwt-secret-not-for-any-deployed-environment
TOTP_ENCRYPTION_KEY=7561742d6532652d6f6e6c792d746f74702d6b65792d6e6f742d6465706c6f79

JWT_SESSION_EXPIRE_HOURS=72

FAILED_LOGIN_ATTEMPT_THRESHOLD=7
FAILED_LOGIN_ATTEMPT_WINDOW_DURATION=5min
FAILED_LOGIN_LOCKOUT_DURATION=5min

# Hours an invite link works before it expires (B035).
INVITE_TTL_HOURS=72

# Lets POST/PUT /user and /userInvite turn mfaExempt on (B097). true ONLY
# for the test harness: the suites create password-only throwaway logins.
# Every other file, dev and every server included, says false.
ALLOW_MFA_EXEMPT_VIA_API=true

MAX_USER_REQ_PER_MIN=100000
MAX_UNAUTH_REQ_PER_MIN=10000

# 0 for Playwright; bin/300-run-tests py sets 1 in its pytest copy.
TRUSTED_PROXY_COUNT=0

CORS_ALLOWED_ORIGINS=http://localhost:5182

APP_NAME="Proto App"
SERVER_NAME=proto-api-e2e
LOG_LEVEL=info
# Loopback only: nothing off the host reaches the harness, so the pytest copy's
# TRUSTED_PROXY_COUNT=1 trusts an X-Forwarded-For only the tests can send.
ENABLE_TLS=false
SERVER_PORT=8082
SERVER_BIND_ADDRESS=127.0.0.1

TEST_BASE_URL=http://127.0.0.1:8082

# The issue-report module on, so the suites reach its routes and page; the
# relay stays off (no ISSUE_RELAY_* keys), so reports stay in the app.
ISSUE_REPORTS_ENABLED=true
