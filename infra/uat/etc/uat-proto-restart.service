# /srv/uat-proto/etc/uat-proto-restart.service, symlinked from
# /etc/systemd/system/ (infra/README.md). Runs as root: the hook user
# only touches stg/restart.request.
[Unit]
Description=Restart proto-api on request

[Service]
Type=oneshot
ExecStart=/bin/rm -f /srv/uat-proto/stg/restart.request
ExecStart=/bin/systemctl restart uat-proto-api
