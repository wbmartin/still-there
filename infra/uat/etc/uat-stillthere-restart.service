# /srv/uat-stillthere/etc/uat-stillthere-restart.service, symlinked from
# /etc/systemd/system/ (infra/README.md). Runs as root: the hook user
# only touches stg/restart.request.
[Unit]
Description=Restart stillthere-api on request

[Service]
Type=oneshot
ExecStart=/bin/rm -f /srv/uat-stillthere/stg/restart.request
ExecStart=/bin/systemctl restart uat-stillthere-api
