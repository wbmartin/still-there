# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:shrmpl-hook, chmod 0640
#
# Same keys as etc/loc-test.env, host values. Sourced by bin/200-run-tests via
# uat-proto-run-tests (PROTO_TEST_ENV). proto_ci has CREATEDB and owns only
# the two scratch databases; it must not be able to CONNECT to uat_proto_db.

export PSQL="psql -h 127.0.0.1 -U proto_ci"
export PGPASSWORD=SERVERONLY
export PROTO_TEST_DB=uat_proto_test_db
export PROTO_E2E_DB=uat_proto_e2e_db

export PROTO_PG_URL_BASE="postgres://proto_ci:SERVERONLY@127.0.0.1:5432"

export PROTO_TEST_DATABASE_URL="postgres://proto_ci:SERVERONLY@127.0.0.1:5432/uat_proto_test_db"

export PROTO_E2E_API_ENV=/srv/uat-proto/etc/uat-proto-e2e-api.env

export PROTO_TEST_LOG_DIR=/srv/uat-proto/stg

export CI=1
