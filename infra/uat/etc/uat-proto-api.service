
[Unit]
Description=Proto API (Go)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=proto
Group=proto
ExecStart=/srv/uat-proto/libexec/api-srv /srv/uat-proto/etc/uat-proto-api.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/uat-proto/log

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uat-proto-api

[Install]
WantedBy=multi-user.target
