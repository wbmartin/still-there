# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:shrmpl-hook, chmod 0640

CONTAINER_REGISTRY_SERVER=SERVERONLY
CONTAINER_REGISTRY_USER=SERVERONLY
CONTAINER_REGISTRY_PASSWORD=SERVERONLY

SERVICE=uat-proto-api
HEALTH_URL=http://127.0.0.1:8088/health
DEPLOY_TAG=uat

# Must match HOOK_ALLOWED_BRANCHES in shrmpl-etc/.
BRANCH_TO_CHECKOUT=main
REPO_URL=SERVERONLY
BUILD_STG=/build-stg/proto

SLACK_WEBHOOK=https://hooks.slack.com/services/SERVERONLY

# uat-proto-renew-web-certs (runs as root from cron)
SITE_NAME=uat-proto.example.com
CERTBOT_EMAIL=SERVERONLY
CERT_HEALTHCHECK_URL=SERVERONLY
