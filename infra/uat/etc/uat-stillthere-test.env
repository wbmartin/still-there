# Note this repo file is a redacted copy of the server file.
# On the server:  chown root:shrmpl-hook, chmod 0640
#
# Same keys as etc/loc-test.env, host values. Sourced by bin/300-run-tests via
# uat-stillthere-run-tests (TEST_ENV). stillthere_ci has CREATEDB and owns only
# the two scratch databases; it must not be able to CONNECT to uat_stillthere_db.

export PGUSER=stillthere_ci
export PGPASSWORD=SERVERONLY
export PGHOST=127.0.0.1
export PGPORT=5432
export PSQL="psql -h $PGHOST -U $PGUSER"
export TEST_DB=uat_stillthere_test_db
export E2E_DB=uat_stillthere_e2e_db

export TEST_PG_URL_BASE="postgres://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT"

export TEST_DATABASE_URL="$TEST_PG_URL_BASE/$TEST_DB"

export E2E_API_ENV=/srv/uat-stillthere/etc/uat-stillthere-e2e-api.env

export TEST_LOG_DIR=/srv/uat-stillthere/stg

export CI=1
