# /srv/uat-stillthere/etc/uat-stillthere-restart.path, symlinked from
# /etc/systemd/system/ (infra/README.md). Runs as root: the hook user
# only touches stg/restart.request.
[Unit]
Description=Watch for a stillthere-api restart request

[Path]
PathExists=/srv/uat-stillthere/stg/restart.request
Unit=uat-stillthere-restart.service

[Install]
WantedBy=multi-user.target
