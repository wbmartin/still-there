# /srv/uat-proto/etc/uat-proto-restart.path, symlinked from
# /etc/systemd/system/ (infra/README.md). Runs as root: the hook user
# only touches stg/restart.request.
[Unit]
Description=Watch for a proto-api restart request

[Path]
PathExists=/srv/uat-proto/stg/restart.request
Unit=uat-proto-restart.service

[Install]
WantedBy=multi-user.target
