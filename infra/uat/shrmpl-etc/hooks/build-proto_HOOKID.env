# Note this repo file is a redacted copy of the server file (/srv/shrmpl/etc/).
# HOOKID in the filename is the hook's id (the last path segment of HOOK_URL);
# the server file is named build-<app>_<hookid>.env.
HOOK_PROVIDER=github
HOOK_SECRET=SERVERONLY
#HOOK_URL=https://SERVERONLY/hook/HOOKID
HOOK_ALLOWED_BRANCHES=main
HOOK_SCRIPT=/srv/uat-proto/bin/uat-proto-build
# The build waits up to 30 min for a running one (uat-proto-build).
HOOK_TIMEOUT=3600

HOOK_DEDUPE_WINDOW=50

HOOK_SLACK_WEBHOOK=https://hooks.slack.com/services/SERVERONLY
