.DS_Store
dist
etc/crt/*.pem
tmp/
src/api-srv/server
# A bare `go build` in src/load-test; bin/330 builds to tmp/test-logs/.
src/load-test/load-test
tests/.venv/
tests/__pycache__/

# Environment / editor
.env.local
# Per-machine Claude Code permissions
/.claude/settings.local.json
# Tracker token files agent tooling may write to the repo root. Root
# only, so no tracked file or bin/ script matches; see DERIVING.md §5.
/*-token
# Stray root-level npm install (the web app lives in src/web-app)
/node_modules/
.idea/
.vscode/*
*.swp

# Python
.venv/
__pycache__/
.pytest_cache/

# Logs (bin/300-run-tests writes its own under tmp/, ignored above)
logs/
*.log

# Playwright. Leading **/ on purpose: a pattern containing a slash is anchored
# to this file's directory, and the suite lives in src/web-app/tests/e2e/.
# .auth/ holds a live session cookie rebuilt on every run.
**/playwright-report/
**/test-results/
**/tests/e2e/.auth/
