.DS_Store
examples
bin/tools/*
dist
etc/crt/*.pem
# Vault secrets (DATABASE_URL, JWT_SECRET, TOTP key); keep only the .example
etc/vault-configs/*
!etc/vault-configs/*.example
tmp/
src/api-srv/server
tests/.venv/
tests/__pycache__/
# Generated by bin/310 and bin/320 on every run (PS0014 decides the final home)
tests/reports/

# Environment / editor
.env.local
# Stray root-level npm install (the web app lives in src/web-app)
/node_modules/
.idea/
.vscode/*
*.swp

# Python
.venv/
__pycache__/
.pytest_cache/

# Logs and scratch (bin/200-run-tests writes tmp/test-logs/)
logs/
*.log

# Playwright. Leading **/ on purpose: a pattern containing a slash is anchored
# to this file's directory, and the suite lives in src/web-app/tests/e2e/.
# .auth/ holds a live session cookie rebuilt on every run.
**/playwright-report/
**/test-results/
**/tests/e2e/.auth/
