# The API the vite dev server (bin/220) proxies /api to: the dev API,
# bin/215, at SERVER_PORT in etc/loc-api-srv.env. The e2e stack does not
# use this value; playwright.config.ts passes its own VITE_API_PROXY_URL
# (the test API's port, from etc/e2e-api-srv.env).
VITE_API_PROXY_URL=http://localhost:8080
