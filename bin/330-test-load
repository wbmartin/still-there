#!/bin/bash
# Load test against a RUNNING API (start one with bin/215-run-api-srv).
#   bin/330-test-load [load-test flags...]      # default: 60s, 100 workers
#   bin/300-run-tests load                      # same thing
#
# Target and credentials come from etc/loc-api-srv.env (TEST_BASE_URL) and
# the seeded admin user (sql/fixtures); LOAD_TEST_ENV=<file> to use another
# API env file. The report lands in tmp/test-reports/ (gitignored).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

ENV_FILE="${LOAD_TEST_ENV:-$PROJECT_ROOT/etc/loc-api-srv.env}"
[ -r "$ENV_FILE" ] || { echo "[ERROR] $ENV_FILE missing or unreadable"; exit 1; }
TEST_BASE_URL="$(sed -nE 's/^TEST_BASE_URL=[[:space:]]*//p' "$ENV_FILE" | head -1)"
[ -n "$TEST_BASE_URL" ] || { echo "[ERROR] TEST_BASE_URL not set in $ENV_FILE"; exit 1; }
curl -sf -m 3 "$TEST_BASE_URL/health" >/dev/null 2>&1 \
  || { echo "[ERROR] nothing answering at $TEST_BASE_URL/health -- start the API first (bin/215-run-api-srv)"; exit 1; }

REPORT_DIR="$PROJECT_ROOT/tmp/test-reports"
mkdir -p dist "$REPORT_DIR"
echo "[INFO] go build load-test"
( cd src/load-test && go build -o "$PROJECT_ROOT/dist/load-test" . )

REPORT="$REPORT_DIR/load_test_$(date +%Y%m%d_%H%M%S).html"
echo "[INFO] load test -> $TEST_BASE_URL (report: $REPORT)"
"$PROJECT_ROOT/dist/load-test" --base-url "$TEST_BASE_URL" --duration 60s --concurrency 100 --output "$REPORT" "$@"
