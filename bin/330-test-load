#!/bin/bash

set -e

echo "Building and running API load test..."

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to project root directory
pushd "$PROJECT_ROOT" > /dev/null

# Ensure dist directory exists
mkdir -p dist

# Build the load test binary
echo "Building load test binary..."
cd "src/api-srv"
go build -o "../../dist/load-test" ./cmd/load-test

# Change back to project root for checking and running
cd "$PROJECT_ROOT"

# Check if binary exists and is executable
if [ ! -f "dist/load-test" ]; then
    echo "Error: Load test binary not found at $PWD/dist/load-test"
    ls -la dist/ 2>/dev/null || echo "dist directory not found"
    exit 1
fi
if [ ! -x "dist/load-test" ]; then
    echo "Error: Load test binary not executable at $PWD/dist/load-test"
    exit 1
fi

# Read configuration from env file
if [ -f "etc/loc-api-srv.env" ]; then
    # Extract TEST_BASE_URL from env file, default to http://localhost:8080 if not found
    TEST_BASE_URL=$(grep -E "^TEST_BASE_URL=" etc/loc-api-srv.env | cut -d'=' -f2 || echo "http://localhost:8080")
else
    TEST_BASE_URL="http://localhost:8080"
fi

# Set default arguments
DEFAULT_ARGS="--base-url $TEST_BASE_URL --duration 1m"

# Run the load test with defaults plus any additional arguments
echo "Running load test with base URL: $TEST_BASE_URL"
"./dist/load-test" $DEFAULT_ARGS "$@"

# Return to original directory
popd > /dev/null
