#!/bin/bash

# Test Repository and Model layers only (excluding handlers)
# This script runs focused unit tests for the core data logic

set -e

echo "Running Repository + Model Tests (excluding handlers)..."

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to the API server source directory
pushd "$PROJECT_ROOT/src/api-srv" > /dev/null

# Clean any existing test data first
# echo "Cleaning existing test data..."
# psql -d loc_starter_db -c "
#   DELETE FROM example WHERE example_text LIKE 'Test%' OR example_text LIKE 'RepoTest%';
#   SELECT setval('example_example_id_seq', (SELECT COALESCE(MAX(example_id), 0) + 1 FROM example));
# " 2>/dev/null || echo "Database cleanup skipped (may not be running)"

# Run tests for repository and model packages only
echo "Running repository tests..."
go test -v ./internal/repository/...

echo "Running model tests..."
go test -v ./internal/model/...

# Create reports directory if it doesn't exist
mkdir -p ../../tests/reports

# Generate coverage report for repository and model only
echo "Generating coverage report..."
go test -coverprofile=../../tests/reports/repo_model_coverage.out ./internal/repository/... ./internal/model/...

# Display coverage summary
echo ""
echo "Coverage Summary:"
go tool cover -func=../../tests/reports/repo_model_coverage.out

# Optional: Generate HTML coverage report
echo ""
echo "Generating HTML coverage report..."
go tool cover -html=../../tests/reports/repo_model_coverage.out -o ../../tests/reports/repo_model_coverage.html

echo ""
echo "Tests completed successfully!"
echo "Coverage report: ../../tests/reports/repo_model_coverage.html"
echo "Coverage data: ../../tests/reports/repo_model_coverage.out"

# Return to original directory
popd > /dev/null
