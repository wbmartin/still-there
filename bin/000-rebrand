#!/bin/bash
# Rename this app: the mechanical half of DERIVING.md.
#
#   bin/000-rebrand <slug> "<Display Name>" [--module <go module path>]
#
#   slug      [a-z][a-z0-9]*  binaries, databases, roles, service names, hostnames
#   name      what people see: web title, login page, TOTP issuer, unit description
#   --module  Go module path (default: <slug>-api). Rewrites go.mod and every import.
#
# Reads the CURRENT identity from etc/app.env, rewrites every tracked text
# file, renames the infra/ files that carry the slug, then writes etc/app.env
# and prints the steps that need a human (secrets, CLAUDE.md).
# Refuses on a dirty tree so the result is one reviewable diff. Idempotent:
# run it again with a new slug to rename again.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

usage() { sed -n '2,13p' "$0"; exit 2; }
[ $# -ge 2 ] || usage
NEW="$1"; NEW_NAME="$2"; shift 2
NEW_MODULE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --module) NEW_MODULE="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ "$NEW" =~ ^[a-z][a-z0-9]*$ ]] || { echo "[ERROR] slug must match [a-z][a-z0-9]*: $NEW"; exit 1; }
[ -n "$NEW_NAME" ] || { echo "[ERROR] display name is empty"; exit 1; }
git diff --quiet && git diff --cached --quiet || { echo "[ERROR] working tree is dirty; commit or stash first so the rename is one diff"; exit 1; }

# shellcheck disable=SC1091
source etc/app.env
OLD="$APP_SLUG"; OLD_NAME="$APP_DISPLAY_NAME"
[ "$OLD" != "$NEW" ] || [ "$OLD_NAME" != "$NEW_NAME" ] || [ -n "$NEW_MODULE" ] \
  || { echo "nothing to do: already $OLD / \"$OLD_NAME\""; exit 0; }
OLD_MODULE="$(cd src/api-srv && go list -m)"
[ -n "$NEW_MODULE" ] || NEW_MODULE="$NEW-api"
echo "slug    $OLD -> $NEW"
echo "name    \"$OLD_NAME\" -> \"$NEW_NAME\""
echo "module  $OLD_MODULE -> $NEW_MODULE"

# --- 1. text substitutions over every tracked text file ----------------------
# Order matters: specific tokens first, the bare slug last. Word boundaries
# keep "ProtoStack" (the template's own name), "protocol" and
# "X-Forwarded-Proto" untouched.
FILES="$(git ls-files | grep -v "^bin/000-rebrand$" \
  | while read -r f; do [ -f "$f" ] && grep -Iq . "$f" && echo "$f"; done)"
# shellcheck disable=SC2086
perl -pi -e "
  s/\b${OLD}-(api|migrate|web)\b/${NEW}-\$1/g;
  s/\b(uat|prd|loc)-${OLD}\b/\$1-${NEW}/g;
  s/\b(uat|prd|loc)_${OLD}_/\$1_${NEW}_/g;
  s/\b${OLD}_(app|ddl|ci)\b/${NEW}_\$1/g;
  s/_${OLD}_db\b/_${NEW}_db/g;
  s#/build-stg/${OLD}\b#/build-stg/${NEW}#g;
  s/\b(build|promote)-${OLD}_/\$1-${NEW}_/g;
  s/vnd\.${OLD}\./vnd.${NEW}./g;
  s/\b${OLD}_api_server\b/${NEW}_api_server/g;
  s/\Q${OLD_NAME}\E/${NEW_NAME}/g;
  s/\b\u${OLD} API\b/${NEW_NAME} API/g;
  s/\b${OLD}\b/${NEW}/g;
" $FILES

# --- 2. Go module path -------------------------------------------------------
if [ "$OLD_MODULE" != "$NEW_MODULE" ]; then
  ( cd src/api-srv && go mod edit -module "$NEW_MODULE" )
  # shellcheck disable=SC2086
  perl -pi -e "s#\Q${OLD_MODULE}\E#${NEW_MODULE}#g" $(git ls-files 'src/api-srv/*.go' 'src/api-srv/**/*.go')
fi

# --- 3. files and directories that carry the slug in their name --------------
git ls-files infra | grep -E "(^|[/_-])${OLD}[_.-]" | sort -r | while read -r old; do
  new="$(printf '%s' "$old" | perl -pe "s/(^|[\/_-])${OLD}([_.-])/\$1${NEW}\$2/g")"
  mkdir -p "$(dirname "$new")"; git mv "$old" "$new"
done

# --- 4. the identity file ----------------------------------------------------
perl -pi -e "s/^APP_SLUG=.*/APP_SLUG=${NEW}/; s/^APP_DISPLAY_NAME=.*/APP_DISPLAY_NAME=\"${NEW_NAME}\"/" etc/app.env

# --- 5. prove it compiles ------------------------------------------------------
( cd src/api-srv && go build ./... ) && echo "[ok] go build"
( cd src/web-app && npx tsc --noEmit -p tsconfig.app.json ) && echo "[ok] tsc"

echo
echo "Renamed. Review with: git status && git diff --stat"
echo "Left for a human — see DERIVING.md:"
echo "  - rotate the local passwords and secrets (roles.sql, fixtures, etc/*.env)"
echo "  - rename infra/uat, infra/prd to the real host names"
echo "  - CLAUDE.md: first paragraph and Layout describe ProtoStack; make them describe $NEW"
echo "  - CLAUDE.md: add the DERIVING.md §8 Template lineage block; derived from commit $(git rev-parse --short HEAD) on $(git log -1 --format=%cs)"
echo "  - local Postgres: databases are now loc_${NEW}_*; bin/510 rebuilds the scratch ones"
