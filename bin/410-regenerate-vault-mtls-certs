#!/bin/bash

# Regenerate mTLS certificates for shrmpl-vault
# Output: etc/crt/shrmpl_vault_mtls_ca.pem, etc/crt/shrmpl_vault_mtls_ca_privkey.pem,
#         etc/crt/shrmpl_vault_mtls_client_cert.pem, etc/crt/shrmpl_vault_mtls_client_privkey.pem,
#         etc/crt/shrmpl_vault_mtls_client_privkey_pkcs8.pem

set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CRT_DIR="$PROJECT_ROOT/etc/crt"

echo "Regenerating mTLS certificates for shrmpl-vault..."

# Create crt directory if it doesn't exist
mkdir -p "$CRT_DIR"

# Generate CA private key
echo "Generating CA private key..."
openssl genrsa -out "$CRT_DIR/shrmpl_vault_mtls_ca_privkey.pem" 2048

# Generate CA certificate
echo "Generating CA certificate..."
openssl req -new -x509 -days 365 -key "$CRT_DIR/shrmpl_vault_mtls_ca_privkey.pem" -out "$CRT_DIR/shrmpl_vault_mtls_ca.pem" -subj "/C=US/ST=CA/L=San Francisco/O=Dev/CN=shrmpl-vault-ca" -extensions v3_ca -config <(echo "[v3_ca]
basicConstraints=CA:TRUE
keyUsage=keyCertSign,cRLSign")

# Generate client private key
echo "Generating client private key..."
openssl genrsa -out "$CRT_DIR/shrmpl_vault_mtls_client_privkey.pem" 2048

# Generate client certificate signing request
echo "Generating client CSR..."
openssl req -new -key "$CRT_DIR/shrmpl_vault_mtls_client_privkey.pem" -out "$CRT_DIR/client.csr" -subj "/C=US/ST=CA/L=San Francisco/O=Dev/CN=client"

# Generate client certificate signed by mTLS CA
echo "Generating client certificate..."
openssl x509 -req -days 365 -in "$CRT_DIR/client.csr" -CA "$CRT_DIR/shrmpl_vault_mtls_ca.pem" -CAkey "$CRT_DIR/shrmpl_vault_mtls_ca_privkey.pem" -CAcreateserial -out "$CRT_DIR/shrmpl_vault_mtls_client_cert.pem"

# Convert client private key to PKCS8 format
echo "Converting client key to PKCS8..."
openssl pkcs8 -topk8 -inform PEM -outform PEM -in "$CRT_DIR/shrmpl_vault_mtls_client_privkey.pem" -out "$CRT_DIR/shrmpl_vault_mtls_client_privkey_pkcs8.pem" -nocrypt

# Clean up CSR files
echo "Cleaning up temporary files..."
rm -f "$CRT_DIR/client.csr" "$CRT_DIR/shrmpl_vault_mtls_ca.srl"

echo "Certificate regeneration complete."
echo "CA cert: $CRT_DIR/shrmpl_vault_mtls_ca.pem"
echo "CA key: $CRT_DIR/shrmpl_vault_mtls_ca_privkey.pem"
echo "Client cert: $CRT_DIR/shrmpl_vault_mtls_client_cert.pem"
echo "Client key: $CRT_DIR/shrmpl_vault_mtls_client_privkey.pem"
echo "Client key (PKCS8): $CRT_DIR/shrmpl_vault_mtls_client_privkey_pkcs8.pem"
echo ""
echo "Note: Restart shrmpl-vault and any services using these certificates."