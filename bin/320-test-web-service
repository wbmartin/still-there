#!/bin/bash

# Integration tests for web service
# Tests the full HTTP stack including authentication, CSRF, and CRUD operations
# Reads the actual port from the config file

set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Read the server port from config file
CONFIG_FILE="$PROJECT_ROOT/etc/loc-api-srv.env"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "❌ ERROR: Config file not found: $CONFIG_FILE"
    exit 1
fi

TEST_BASE_URL=$(grep "^TEST_BASE_URL=" "$CONFIG_FILE" | cut -d'=' -f2 | tr -d ' ')
if [ -z "$TEST_BASE_URL" ]; then
    echo "❌ ERROR: TEST_BASE_URL not found in config file"
    echo "Please add TEST_BASE_URL=https://your-tls-hostname:port to $CONFIG_FILE"
    exit 1
fi

BASE_URL="$TEST_BASE_URL"

echo "Running Integration Tests (Web Service)..."
echo "Note: Application should be running on $BASE_URL"
echo "Start it with: ./bin/215-run-api-srv"
echo ""

# Check if python3 is available
if ! command -v python3 &> /dev/null; then
    echo "❌ ERROR: python3 is not installed"
    exit 1
fi

# Setup virtual environment for integration tests
VENV_DIR="tests/.venv"
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment for integration tests..."
    cd tests
    python3 -m venv .venv
    cd ..
fi

# Activate virtual environment
echo "Activating virtual environment..."
# shellcheck disable=SC1091
source "tests/.venv/bin/activate"

# Install/update dependencies in virtual environment
echo "Installing test dependencies..."
cd tests
pip install -r requirements.txt
cd ..

# Check if application is running
echo "Checking if application is running on $BASE_URL..."
if ! curl -s -f "$BASE_URL/health" > /dev/null 2>&1; then
    echo "❌ ERROR: Application is not running on $BASE_URL"
    echo "Please start it first with: ./bin/215-run-api-srv"
    exit 1
fi
echo "✅ Application is running on $BASE_URL"

# Run the integration tests
echo "Running integration tests..."
cd tests

# Set environment variable for test base URL
export TEST_BASE_URL="$BASE_URL"

# Run tests with verbose output and generate HTML report
python3 -m pytest -v --tb=short --html=reports/integration_test_report.html --self-contained-html

echo ""
echo "✅ Integration tests completed!"
echo "📊 HTML Report: tests/reports/integration_test_report.html"

# Deactivate virtual environment
deactivate
