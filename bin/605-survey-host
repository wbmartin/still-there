#!/usr/bin/env bash
# Read-only record of a deploy host, taken before a post-sales step changes
# it (doc/330 0.1, doc/331 0.1): users, tools, /srv, units, Postgres roles,
# databases and owners, nginx, fail2ban, cron, listening ports. Runs one
# probe on the host under sudo (you type the sudo password once) and saves
# the output to tmp/survey/<host>-<stamp>.txt. Keep that file: it is the
# "before" a rollback or a question later is answered from.
#
#   bin/605-survey-host <ssh-host>
#
# Changes nothing on the host. Names come from etc/app.env (APP_SLUG) and
# etc/uat-deploy.env (SVC_USER, DB_NAME); both uat- and prd- layouts are
# looked for and an absent one is skipped. Env files are listed as key
# names only, never values. Units, nginx sites and crontab pass through a
# mask for anything shaped like a password, secret, token or URL
# credential; the mask is best-effort, so read the file before sharing it.

set -euo pipefail

HOST="${1:?usage: bin/605-survey-host <ssh-host>}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
# shellcheck disable=SC1091
source "$PROJECT_ROOT/etc/app.env"
# shellcheck disable=SC1091
source "$PROJECT_ROOT/etc/uat-deploy.env"
for var in APP_SLUG SVC_USER DB_NAME; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set"; exit 1; }
done
OUT_DIR="$PROJECT_ROOT/tmp/survey"
OUT="$OUT_DIR/$HOST-$(date +%Y%m%d_%H%M).txt"
mkdir -p "$OUT_DIR"

read -r -d '' PROBE <<'PROBE' || true
set -u
# no pager anywhere: systemctl and psql otherwise wait for 'q' over ssh -t
export SYSTEMD_PAGER='' PAGER=cat PSQL_PAGER=cat
h() { printf '\n######## %s\n' "$*"; }
keys() {
  [ -f "$1" ] || return 0
  echo "-- $1 ($(stat -c '%U:%G %a' "$1"))"
  sed -nE 's/^(export )?([A-Za-z_][A-Za-z0-9_]*)=.*/\2=/p' "$1"
}
mask() {
  sed -E \
    -e 's#(://[^:/@ ]+):[^@ ]+@#\1:***@#g' \
    -e 's/(authorization"?)[ =:][^;]*/\1 ***/Ig' \
    -e 's/((password|passwd|secret|token|api[_-]?key|credential)[A-Za-z0-9_.-]*"?)([ ]*[=:][ ]*|[ ]+)[^ ;]+/\1=***/Ig'
}
psqlq() { sudo -u postgres psql -P pager=off -X "$@"; }

h host; hostname; uname -r; . /etc/os-release && echo "$PRETTY_NAME"; uptime
h disk; df -h / /srv 2>/dev/null; free -h
h users
for u in "$SVC_USER" "$APP_SLUG" "svc-$APP_SLUG" shrmpl-hook postgres; do
  id "$u" 2>/dev/null || echo "no user $u"; done
getent group | grep -E "$APP_SLUG|shrmpl" || true

h tools on root PATH
for t in go node npm oras jq curl openssl certbot nginx psql pg_dump \
    pg_restore git fail2ban-client docker; do
  printf '%-16s %s\n' "$t" "$(command -v "$t" || echo MISSING)"; done
go version 2>/dev/null; node --version 2>/dev/null
oras version 2>/dev/null | head -1; psql --version 2>/dev/null
if id shrmpl-hook >/dev/null 2>&1; then
  h tools on shrmpl-hook PATH
  sudo -u shrmpl-hook -H bash -lc 'for t in go node npm oras jq git pg_dump; do printf "%-10s %s\n" "$t" "$(command -v "$t" || echo MISSING)"; done' 2>&1
fi

h /srv; ls -la /srv
for d in "/srv/uat-$APP_SLUG" "/srv/prd-$APP_SLUG"; do
  [ -d "$d" ] || { echo "no $d"; continue; }
  h "$d"; ls -la "$d"
  for s in libexec etc bin stg backup log web-pub crt; do
    [ -d "$d/$s" ] && { echo "-- $d/$s"; ls -la "$d/$s" | head -30; }
  done
  for f in "$d"/etc/*.env; do keys "$f"; done
done
ls -d /build-stg/* 2>/dev/null

h systemd units
systemctl list-units --all --no-pager 'uat-*' 'prd-*' 'shrmpl*' 2>/dev/null \
  | head -40
for env in uat prd; do
  for u in "$env-$APP_SLUG-api" "$env-$APP_SLUG-restart.path" \
      "$env-$APP_SLUG-restart"; do
    systemctl cat --no-pager "$u" >/dev/null 2>&1 || continue
    systemctl cat --no-pager "$u" | mask
    systemctl show --no-pager -p ActiveState,MainPID,User "$u"
  done
done

h postgres
psqlq -XAtc 'select version()'
psqlq -c '\du'
psqlq -c '\l'
for db in "$DB_NAME" "uat_${APP_SLUG}_db" "prd_${APP_SLUG}_db" \
    "${DB_NAME}_presales" "uat_${APP_SLUG}_db_presales"; do
  case " ${seen_db_list:-} " in *" $db "*) continue ;; esac
  seen_db_list="${seen_db_list:-} $db"
  psqlq -XAtc "select 1 from pg_database where datname = '$db'" \
    | grep -q 1 || { echo "no database $db"; continue; }
  echo "-- $db"
  psqlq -XAt -d "$db" -c "select 'owner ' || tableowner, count(*) from pg_tables where schemaname = 'public' group by 1"
  psqlq -XAt -d "$db" -c "select 'schema_migration ' || max(version) from schema_migration" 2>&1
  psqlq -XAt -d "$db" -c "select 'tenant ' || security_context_id || ' logins ' || count(*) || ' ' || string_agg(DISTINCT account_status, ',') from app_user where delete_ts is null group by security_context_id order by security_context_id" 2>&1
  psqlq -XAt -d "$db" -c "select 'datacl ' || coalesce(datacl::text, '(default: PUBLIC connect)') from pg_database where datname = '$db'"
  psqlq -XAt -d "$db" -c "select 'schema public owner ' || nspowner::regrole || ' acl ' || coalesce(nspacl::text, '') from pg_namespace where nspname = 'public'"
  psqlq -XAt -d "$db" -c "select 'default acl ' || defaclrole::regrole::text || ' ' || defaclobjtype::text || ' ' || defaclacl::text from pg_default_acl"
done
grep -vE '^\s*(#|$)' "$(psqlq -XAtc 'show hba_file')" | mask

h nginx
ls -la /etc/nginx/sites-enabled/ 2>&1
for f in /etc/nginx/sites-enabled/*; do
  [ -e "$f" ] || continue
  grep -qE "$APP_SLUG" "$f" "$(readlink -f "$f")" 2>/dev/null || continue
  echo "-- $f -> $(readlink -f "$f")"; mask < "$f"
done
ls /etc/letsencrypt/live/ 2>/dev/null

h shrmpl
ls -la /srv/shrmpl 2>/dev/null; find /srv/shrmpl/etc -maxdepth 2 2>/dev/null | sort
systemctl list-units --all --no-pager 2>/dev/null \
  | grep -iE 'shrmpl|nack|pulse' || true
h deploy keys other apps on this host use
for f in /srv/*/etc/*deploy*.env; do keys "$f"; done 2>/dev/null

h fail2ban
ls -la /etc/fail2ban/ 2>&1
sed -E 's/^(ignoreip\s*=).*/\1 ***/' /etc/fail2ban/jail.local 2>/dev/null \
  | grep -vE '^\s*(#|$)'
fail2ban-client status 2>&1

h cron
crontab -l 2>&1 | mask; ls /etc/cron.d 2>&1

h listening ports; ss -ltnp | sed 1d | awk '{print $4, $6}' | sort
h ufw; ufw status 2>&1 | head -20
PROBE

# The names the probe uses, as assignments ahead of it: values from the
# repo's own env files, quoted for the remote shell.
NAMES="$(printf 'APP_SLUG=%q SVC_USER=%q DB_NAME=%q' \
    "$APP_SLUG" "$SVC_USER" "$DB_NAME")"
echo "surveying $HOST (sudo will ask for your password once) -> $OUT"
ssh -t "$HOST" "sudo bash -c $(printf '%q' "$NAMES; $PROBE")" 2>&1 \
    | tee "$OUT"
echo
echo "saved $OUT"
