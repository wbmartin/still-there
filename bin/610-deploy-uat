#!/bin/bash
# Server-side deploy for a ${APP_NAME}_bundle_*.tar.gz produced by bin/600-bundle-uat.
# Shipped inside the bundle as deploy.sh. Run as root from the extracted bundle dir:
#
#   sudo ./deploy.sh [--no-db] [--no-restart]
#
# stop api -> replace DB -> set the role password -> replace libexec/api-srv (+ <slug>-migrate)
# -> replace web-pub -> start api -> health
# First run also writes etc/api-srv.env from the bundle's api-srv.env.template with secrets
# generated here, installs the systemd unit ($SERVICE.service), writes and links the nginx
# site for $UAT_DOMAIN from nginx-site.conf.template (then nginx -t + reload, and prints the
# certbot line) and retires any hand-started api-srv. It refuses a host on the post-sales
# pipeline (etc/*-<app>-deploy.env present).
#
# This is the presales (pre-agreement) quick-deploy path — see doc/320-presales-uat-deploy.md
# for the one-time host prep this expects (directories, Postgres, nginx installed).
#
# Settings: deploy.env beside this script (written by 600 from etc/uat-deploy.env:
# APP_NAME, APP_ROOT, SERVICE, SVC_USER, DB_APP_ROLE, UAT_DOMAIN), then
# $APP_ROOT/etc/deploy.env if the host keeps one, which wins. Every key is required; there are no inline defaults.

set -euo pipefail
cd "$(dirname "$0")"

BUNDLE_ENV="$PWD/deploy.env"
[ -r "$BUNDLE_ENV" ] || { echo "[ERROR] $BUNDLE_ENV missing (not a bundle produced by bin/600-bundle-uat?)"; exit 1; }
# shellcheck disable=SC1090
source "$BUNDLE_ENV"
[ -n "${APP_ROOT:-}" ] || { echo "[ERROR] APP_ROOT not set by $BUNDLE_ENV"; exit 1; }
HOST_ENV="$APP_ROOT/etc/deploy.env"
if [ -r "$HOST_ENV" ]; then
  echo "[env] $HOST_ENV overrides the bundled deploy.env"
  # shellcheck disable=SC1090
  source "$HOST_ENV"
fi
for var in APP_NAME APP_ROOT SERVICE SVC_USER DB_APP_ROLE UAT_DOMAIN; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $BUNDLE_ENV / $HOST_ENV"; exit 1; }
done
BIN_DST="$APP_ROOT/libexec/api-srv"
MIGRATE_DST="$APP_ROOT/libexec/$APP_NAME-migrate"
WEB_DST="$APP_ROOT/web-pub"
ENV_FILE="$APP_ROOT/etc/api-srv.env"
UNIT_SRC="$APP_ROOT/etc/$SERVICE.service"
UNIT_DST="/etc/systemd/system/$SERVICE.service"
# goes into server_name and these paths: same check as 600
[[ "$UAT_DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] \
  || { echo "[ERROR] UAT_DOMAIN=$UAT_DOMAIN is not a lower-case hostname"; exit 1; }
SITE_FILE="$APP_ROOT/etc/nginx-presales_$UAT_DOMAIN"
SITE_LINK_DIR=/etc/nginx/sites-enabled
SITE_LINK="$SITE_LINK_DIR/$UAT_DOMAIN"
DO_DB=1; DO_RESTART=1
for a in "$@"; do
  case "$a" in
    --no-db) DO_DB=0 ;;
    --no-restart) DO_RESTART=0 ;;
    *) echo "unknown arg: $a"; exit 2 ;;
  esac
done

[ "$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }
# A post-sales host keeps a persistent database that this script would DROP and
# hand back to $DB_APP_ROLE. Its deploy env (infra/<host>/etc/) is the marker;
# etc/deploy.env is this script's own override, so match the slug-named file.
postsales_marker_list=("$APP_ROOT"/etc/*-"$APP_NAME"-deploy.env)
if [ -e "${postsales_marker_list[0]}" ]; then
  echo "[REFUSED] $APP_ROOT is on the post-sales pipeline (${postsales_marker_list[0]} exists)."
  echo "          The presales deploy.sh would drop its database. Deploy through infra/ instead:"
  echo "          infra/README.md, doc/330-uat-postsales-cutover.md."
  exit 1
fi
if [ ! -f api-srv ] || [ ! -f web-pub.tar.gz ]; then
  echo "not a bundle dir (api-srv / web-pub.tar.gz missing)"; exit 1
fi
sed 's/^/  /' MANIFEST 2>/dev/null || true

# --- env file (first run only; never overwritten) ----------------------------
# Secrets come from /dev/urandom here and reach the file through awk's
# environment, never a command line (ps shows argv) and never the bundle.
if [ ! -f "$ENV_FILE" ]; then
  [ -f api-srv.env.template ] || { echo "[ERROR] $ENV_FILE missing and api-srv.env.template not in bundle"; exit 1; }
  echo "[env] writing $ENV_FILE (secrets generated here, once)"
  random_hex() { od -An -vtx1 -N32 /dev/urandom | tr -d ' \n'; }
  env_tmp="$(mktemp "$ENV_FILE.XXXXXX")"  # 0600 until filled
  DB_PASSWORD="$(random_hex)" JWT_SECRET="$(random_hex)" TOTP_KEY="$(random_hex)" awk '
    function put(key,   token, i) {
      token = "__" key "__"
      while ((i = index($0, token)) > 0)
        $0 = substr($0, 1, i - 1) ENVIRON[key] substr($0, i + length(token))
    }
    { put("DB_PASSWORD"); put("JWT_SECRET"); put("TOTP_KEY"); print }' \
    api-srv.env.template > "$env_tmp"
  if grep -q '__[A-Z_]*__' "$env_tmp"; then
    rm -f "$env_tmp"; echo "[ERROR] api-srv.env.template has unfilled __PLACEHOLDERS__"; exit 1
  fi
  chown "root:$SVC_USER" "$env_tmp"; chmod 0640 "$env_tmp"
  mv "$env_tmp" "$ENV_FILE"
fi

DB_NAME="$(sed -nE 's#^DATABASE_URL=postgres://[^/]+/([^?]+).*#\1#p' "$ENV_FILE" | head -1)"
[ -n "$DB_NAME" ] || { echo "[ERROR] cannot read the database name from DATABASE_URL in $ENV_FILE"; exit 1; }
PORT="$(sed -nE 's/^SERVER_PORT=([0-9]+).*/\1/p' "$ENV_FILE" | head -1)"
[ -n "$PORT" ] || { echo "[ERROR] SERVER_PORT not set in $ENV_FILE"; exit 1; }
# Required since B061; a file written before then lacks it (doc/320). Checked
# here so the deploy stops before the service does, not after.
grep -qE '^SERVER_BIND_ADDRESS=.' "$ENV_FILE" || { echo "[ERROR] SERVER_BIND_ADDRESS not set in $ENV_FILE; add SERVER_BIND_ADDRESS=127.0.0.1"; exit 1; }
# Required since B097, same reason.
grep -qE '^ALLOW_MFA_EXEMPT_VIA_API=.' "$ENV_FILE" || { echo "[ERROR] ALLOW_MFA_EXEMPT_VIA_API not set in $ENV_FILE; add ALLOW_MFA_EXEMPT_VIA_API=false"; exit 1; }
HEALTH="http://127.0.0.1:$PORT/health"
DB_LOGIN="$(sed -nE 's#^DATABASE_URL=postgres://([^:@/]+):.*#\1#p' "$ENV_FILE" | head -1)"
[ "$DB_LOGIN" = "$DB_APP_ROLE" ] || { echo "[ERROR] DATABASE_URL in $ENV_FILE logs in as '$DB_LOGIN', not DB_APP_ROLE=$DB_APP_ROLE"; exit 1; }
echo "app=$APP_NAME approot=$APP_ROOT service=$SERVICE db=$DB_NAME role=$DB_APP_ROLE health=$HEALTH"

# --- systemd unit (first run only) -------------------------------------------
if [ ! -f "$UNIT_DST" ]; then
  echo "[unit] installing $SERVICE"
  cat > "$UNIT_SRC" <<UNIT
#   ln -s $UNIT_SRC $UNIT_DST
[Unit]
Description=${APP_NAME} API (Go)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=$SVC_USER
Group=$SVC_USER
WorkingDirectory=$APP_ROOT
ExecStart=$BIN_DST $ENV_FILE
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$APP_ROOT/log

StandardOutput=journal
StandardError=journal
SyslogIdentifier=$SERVICE

[Install]
WantedBy=multi-user.target
UNIT
  ln -sf "$UNIT_SRC" "$UNIT_DST"
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1 || true
fi

# --- nginx site (first run only; never overwritten) ---------------------------
# HTTP only; `certbot --nginx` adds TLS. Skipped, with a note, when the domain is
# a placeholder, the site file exists, or another enabled site already answers
# for the domain (a hand-written presales site is left alone). A site that
# fails nginx -t is unlinked and removed, so nginx is never left unloadable.
# server_name lists names across spaces and lines; whitespace is folded first.
site_taken_re="(^|[ ;{])server_name ([^;]* )?${UAT_DOMAIN//./\\.}[ ;]"
if [[ "$UAT_DOMAIN" == example.com || "$UAT_DOMAIN" == *.example.com ]]; then
  echo "[nginx] UAT_DOMAIN=$UAT_DOMAIN is a placeholder; site not installed (set it in etc/uat-deploy.env)"
elif [ -e "$SITE_FILE" ]; then
  echo "[nginx] $SITE_FILE exists; left alone"
elif ! command -v nginx >/dev/null || [ ! -d "$SITE_LINK_DIR" ]; then
  echo "[nginx] WARNING: nginx (with $SITE_LINK_DIR) not installed; site not installed (doc/320)"
elif [[ "$(nginx -T 2>/dev/null | tr -s '[:space:]' ' ')" =~ $site_taken_re ]]; then
  echo "[nginx] an enabled site already has server_name $UAT_DOMAIN; not installing $SITE_FILE"
else
  [ -f nginx-site.conf.template ] || { echo "[ERROR] nginx-site.conf.template not in bundle"; exit 1; }
  [ ! -e "$SITE_LINK" ] || { echo "[ERROR] $SITE_LINK exists but is not $SITE_FILE; move it aside"; exit 1; }
  echo "[nginx] writing $SITE_FILE, linking $SITE_LINK"
  site_tmp="$(mktemp "$SITE_FILE.XXXXXX")"
  UAT_DOMAIN="$UAT_DOMAIN" APP_ROOT="$APP_ROOT" PORT="$PORT" awk '
    function put(key,   token, i) {
      token = "__" key "__"
      while ((i = index($0, token)) > 0)
        $0 = substr($0, 1, i - 1) ENVIRON[key] substr($0, i + length(token))
    }
    { put("UAT_DOMAIN"); put("APP_ROOT"); put("PORT"); print }' \
    nginx-site.conf.template > "$site_tmp"
  if grep -q '__[A-Z_]*__' "$site_tmp"; then
    rm -f "$site_tmp"; echo "[ERROR] nginx-site.conf.template has unfilled __PLACEHOLDERS__"; exit 1
  fi
  chown root:root "$site_tmp"; chmod 0644 "$site_tmp"
  mv "$site_tmp" "$SITE_FILE"
  ln -s "$SITE_FILE" "$SITE_LINK"
  if ! nginx_check="$(nginx -t 2>&1)"; then
    rm -f "$SITE_LINK" "$SITE_FILE"
    echo "  ${nginx_check//$'\n'/$'\n'  }"
    echo "[ERROR] nginx -t failed with the new site; it was unlinked and removed. Fix and redeploy."
    exit 1
  fi
  systemctl reload nginx
  echo "[nginx] reloaded. Once DNS for $UAT_DOMAIN points here, once:"
  echo "        sudo certbot --nginx -d $UAT_DOMAIN"
fi

# --- stop --------------------------------------------------------------------
if [ "$DO_RESTART" = 1 ]; then
  systemctl stop "$SERVICE" 2>/dev/null || true
  # retire any hand-started copy (./libexec/api-srv ./etc/api-srv.env)
  if pkill -TERM -f "libexec/api-srv" 2>/dev/null; then sleep 2; fi
fi

# --- database ----------------------------------------------------------------
if [ "$DO_DB" = 1 ]; then
  [ -f db.sql ] || { echo "db.sql missing; use --no-db"; exit 1; }
  echo "[db] roles (idempotent)"
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 -f 000-roles.sql
  echo "[db] drop + create $DB_NAME"
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 \
     -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$DB_NAME' AND pid<>pg_backend_pid()" \
     -c "DROP DATABASE IF EXISTS $DB_NAME" \
     -c "CREATE DATABASE $DB_NAME OWNER $DB_APP_ROLE" >/dev/null
  echo "[db] restore db.sql"
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 -d "$DB_NAME" -f db.sql >/dev/null
  # psql does not expand :vars inside $$ bodies, so hand the role in via set_config
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 -d "$DB_NAME" -v role="$DB_APP_ROLE" <<'SQL'
SELECT set_config('deploy.role', :'role', false);
DO $$ DECLARE r record; o text := current_setting('deploy.role'); BEGIN
  FOR r IN SELECT tablename FROM pg_tables WHERE schemaname='public' LOOP
    EXECUTE format('ALTER TABLE public.%I OWNER TO %I', r.tablename, o); END LOOP;
  FOR r IN SELECT sequencename FROM pg_sequences WHERE schemaname='public' LOOP
    EXECUTE format('ALTER SEQUENCE public.%I OWNER TO %I', r.sequencename, o); END LOOP;
END $$;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO db_reader;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO db_writer;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO db_writer;
SQL
  echo "      $(sudo -u postgres psql -Atd "$DB_NAME" -c "select count(*) from information_schema.tables where table_schema='public'") tables"
  # The dump is a full wholesale restore, so schema_migration (if present) travels with it —
  # no migrate step is needed here; the restored DB is already at the dump's migration state.
else
  echo "[db] skipped (--no-db)"
fi

# --- role password = the env file's, every run ---------------------------------
# roles.sql creates the role with the repo's local password; the host's real
# one is whatever DATABASE_URL says. It reaches psql on stdin (printf is a
# builtin), never argv.
DB_PASSWORD="$(sed -nE 's#^DATABASE_URL=postgres://[^:@/]+:([^@]*)@.*#\1#p' "$ENV_FILE" | head -1)"
case "$DB_PASSWORD" in
  ''|*[!A-Za-z0-9._~-]*)
    echo "[ERROR] the DATABASE_URL password in $ENV_FILE is empty or not [A-Za-z0-9._~-]; set a hex one (doc/320)"; exit 1 ;;
esac
echo "[db] $DB_APP_ROLE password from $ENV_FILE"
{
  printf '\\set role %s\n' "$DB_APP_ROLE"
  printf '\\set pw %s\n' "$DB_PASSWORD"
  echo "SELECT format('ALTER ROLE %I PASSWORD %L', :'role', :'pw') \\gexec"
} | sudo -u postgres psql -X -q -v ON_ERROR_STOP=1 -d postgres >/dev/null
unset DB_PASSWORD

# --- binary ------------------------------------------------------------------
echo "[bin] $BIN_DST"
[ -f "$BIN_DST" ] && cp -p "$BIN_DST" "$BIN_DST.prev"
install -o root -g root -m 0755 api-srv "$BIN_DST"

if [ -f "$APP_NAME-migrate" ]; then
  echo "[bin] $MIGRATE_DST"
  [ -f "$MIGRATE_DST" ] && cp -p "$MIGRATE_DST" "$MIGRATE_DST.prev"
  install -o root -g root -m 0755 "$APP_NAME-migrate" "$MIGRATE_DST"
else
  echo "[bin] $APP_NAME-migrate not in bundle — skipping"
fi

# When the server DB was left in place (--no-db), it may be ahead of or behind this
# binary's expected schema. Verify rather than assume; never auto-apply here.
if [ "$DO_DB" = 0 ]; then
  if [ -x "$MIGRATE_DST" ]; then
    echo "[migrate] verify (server DB kept, --no-db)"
    "$MIGRATE_DST" -config "$ENV_FILE" verify || echo "[migrate] WARNING: verify reported an issue — check schema_migration manually"
  else
    echo "[migrate] WARNING: $APP_NAME-migrate not installed — skipping verify (--no-db)"
  fi
fi

# --- web ---------------------------------------------------------------------
echo "[web] $WEB_DST"
rm -rf "$WEB_DST.prev"
[ -d "$WEB_DST" ] && mv "$WEB_DST" "$WEB_DST.prev"
mkdir -p "$WEB_DST"
tar --no-same-owner -C "$WEB_DST" -xzf web-pub.tar.gz
find "$WEB_DST" -name '._*' -delete
chown -R "$SVC_USER:$SVC_USER" "$WEB_DST"

# --- start + health ----------------------------------------------------------
if [ "$DO_RESTART" = 1 ]; then
  systemctl start "$SERVICE"
  for _ in $(seq 1 15); do
    if curl -fsS -m 2 "$HEALTH" >/dev/null 2>&1; then
      echo "[ok] $HEALTH  ($(systemctl is-active "$SERVICE"))"; exit 0
    fi
    sleep 1
  done
  echo "[FAIL] $HEALTH not answering after 15s"
  systemctl status "$SERVICE" --no-pager | tail -15
  journalctl -u "$SERVICE" -n 30 --no-pager
  exit 1
fi
echo "[done] files replaced; api not restarted (--no-restart)"
