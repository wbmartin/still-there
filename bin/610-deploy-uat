#!/bin/bash
# Server-side deploy for a ${APP_NAME}_bundle_*.tar.gz produced by bin/600-bundle-uat.
# Shipped inside the bundle as deploy.sh. Run as root from the extracted bundle dir:
#
#   sudo ./deploy.sh [--no-db] [--no-restart]
#
# stop api -> replace DB -> replace libexec/api-srv (+ proto-migrate) -> replace web-pub -> start api -> health
# First run also installs the systemd unit ($SERVICE.service) and retires any hand-started api-srv.
#
# This is the presales (pre-agreement) quick-deploy path — see doc/320-presales-uat-deploy.md
# for the one-time host prep this expects (etc/api-srv.env already in place, nginx configured).
#
# Env overrides: APP_NAME (proto), APP_ROOT (/srv/uat-${APP_NAME}), SERVICE (uat-${APP_NAME}-api),
#                SVC_USER (www-data), DB_NAME (from APP_ROOT/etc/api-srv.env)

set -euo pipefail
cd "$(dirname "$0")"

APP_NAME="${APP_NAME:-proto}"
APP_ROOT="${APP_ROOT:-/srv/uat-${APP_NAME}}"
SERVICE="${SERVICE:-uat-${APP_NAME}-api}"
SVC_USER="${SVC_USER:-www-data}"
BIN_DST="$APP_ROOT/libexec/api-srv"
MIGRATE_DST="$APP_ROOT/libexec/proto-migrate"
WEB_DST="$APP_ROOT/web-pub"
ENV_FILE="$APP_ROOT/etc/api-srv.env"
UNIT_SRC="$APP_ROOT/etc/$SERVICE.service"
UNIT_DST="/etc/systemd/system/$SERVICE.service"
DO_DB=1; DO_RESTART=1
for a in "$@"; do
  case "$a" in
    --no-db) DO_DB=0 ;;
    --no-restart) DO_RESTART=0 ;;
    *) echo "unknown arg: $a"; exit 2 ;;
  esac
done

[ "$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }
[ -f api-srv ] && [ -f web-pub.tar.gz ] || { echo "not a bundle dir (api-srv / web-pub.tar.gz missing)"; exit 1; }
[ -f "$ENV_FILE" ] || { echo "$ENV_FILE missing"; exit 1; }
sed 's/^/  /' MANIFEST 2>/dev/null || true

DB_NAME="${DB_NAME:-$(sed -nE 's#^DATABASE_URL=postgres://[^/]+/([^?]+).*#\1#p' "$ENV_FILE" | head -1)}"
PORT="$(sed -nE 's/^SERVER_PORT=([0-9]+).*/\1/p' "$ENV_FILE" | head -1)"
HEALTH="http://127.0.0.1:${PORT:-8088}/health"
echo "app=$APP_NAME approot=$APP_ROOT service=$SERVICE db=$DB_NAME health=$HEALTH"

# --- systemd unit (first run only) -------------------------------------------
if [ ! -f "$UNIT_DST" ]; then
  echo "[unit] installing $SERVICE"
  cat > "$UNIT_SRC" <<UNIT
#   ln -s $UNIT_SRC $UNIT_DST
[Unit]
Description=${APP_NAME} API (Go)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=$SVC_USER
Group=$SVC_USER
WorkingDirectory=$APP_ROOT
ExecStart=$BIN_DST $ENV_FILE
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$APP_ROOT/log

StandardOutput=journal
StandardError=journal
SyslogIdentifier=$SERVICE

[Install]
WantedBy=multi-user.target
UNIT
  ln -sf "$UNIT_SRC" "$UNIT_DST"
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1 || true
fi

# --- stop --------------------------------------------------------------------
if [ "$DO_RESTART" = 1 ]; then
  systemctl stop "$SERVICE" 2>/dev/null || true
  # retire any hand-started copy (./libexec/api-srv ./etc/api-srv.env)
  pkill -TERM -f "libexec/api-srv" 2>/dev/null && sleep 2 || true
fi

# --- database ----------------------------------------------------------------
if [ "$DO_DB" = 1 ]; then
  [ -f db.sql ] || { echo "db.sql missing; use --no-db"; exit 1; }
  echo "[db] roles (idempotent)"
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 -f 000-roles.sql
  echo "[db] drop + create $DB_NAME"
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 \
     -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='$DB_NAME' AND pid<>pg_backend_pid()" \
     -c "DROP DATABASE IF EXISTS $DB_NAME" \
     -c "CREATE DATABASE $DB_NAME OWNER proto_app_svc_account" >/dev/null
  echo "[db] restore db.sql"
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 -d "$DB_NAME" -f db.sql >/dev/null
  sudo -u postgres psql -q -v ON_ERROR_STOP=1 -d "$DB_NAME" <<'SQL'
DO $$ DECLARE r record; BEGIN
  FOR r IN SELECT tablename FROM pg_tables WHERE schemaname='public' LOOP
    EXECUTE format('ALTER TABLE public.%I OWNER TO proto_app_svc_account', r.tablename); END LOOP;
  FOR r IN SELECT sequencename FROM pg_sequences WHERE schemaname='public' LOOP
    EXECUTE format('ALTER SEQUENCE public.%I OWNER TO proto_app_svc_account', r.sequencename); END LOOP;
END $$;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO db_reader;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO db_writer;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO db_writer;
SQL
  echo "      $(sudo -u postgres psql -Atd "$DB_NAME" -c "select count(*) from information_schema.tables where table_schema='public'") tables"
  # The dump is a full wholesale restore, so schema_migration (if present) travels with it —
  # no migrate step is needed here; the restored DB is already at the dump's migration state.
else
  echo "[db] skipped (--no-db)"
fi

# --- binary ------------------------------------------------------------------
echo "[bin] $BIN_DST"
[ -f "$BIN_DST" ] && cp -p "$BIN_DST" "$BIN_DST.prev"
install -o root -g root -m 0755 api-srv "$BIN_DST"

if [ -f proto-migrate ]; then
  echo "[bin] $MIGRATE_DST"
  [ -f "$MIGRATE_DST" ] && cp -p "$MIGRATE_DST" "$MIGRATE_DST.prev"
  install -o root -g root -m 0755 proto-migrate "$MIGRATE_DST"
else
  echo "[bin] proto-migrate not in bundle — skipping"
fi

# When the server DB was left in place (--no-db), it may be ahead of or behind this
# binary's expected schema. Verify rather than assume; never auto-apply here.
if [ "$DO_DB" = 0 ]; then
  if [ -x "$MIGRATE_DST" ]; then
    echo "[migrate] verify (server DB kept, --no-db)"
    "$MIGRATE_DST" -config "$ENV_FILE" verify || echo "[migrate] WARNING: verify reported an issue — check schema_migration manually"
  else
    echo "[migrate] WARNING: proto-migrate not installed — skipping verify (--no-db)"
  fi
fi

# --- web ---------------------------------------------------------------------
echo "[web] $WEB_DST"
rm -rf "$WEB_DST.prev"
[ -d "$WEB_DST" ] && mv "$WEB_DST" "$WEB_DST.prev"
mkdir -p "$WEB_DST"
tar --no-same-owner -C "$WEB_DST" -xzf web-pub.tar.gz
find "$WEB_DST" -name '._*' -delete
chown -R "$SVC_USER:$SVC_USER" "$WEB_DST"

# --- start + health ----------------------------------------------------------
if [ "$DO_RESTART" = 1 ]; then
  systemctl start "$SERVICE"
  for i in $(seq 1 15); do
    if curl -fsS -m 2 "$HEALTH" >/dev/null 2>&1; then
      echo "[ok] $HEALTH  ($(systemctl is-active "$SERVICE"))"; exit 0
    fi
    sleep 1
  done
  echo "[FAIL] $HEALTH not answering after 15s"
  systemctl status "$SERVICE" --no-pager | tail -15
  journalctl -u "$SERVICE" -n 30 --no-pager
  exit 1
fi
echo "[done] files replaced; api not restarted (--no-restart)"
