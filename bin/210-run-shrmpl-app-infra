#!/bin/bash

# Script to stop any running shrmpl app services and start infrastructure with local configs
# Services: shrmpl-log-srv, shrmpl-kv-srv, shrmpl-vault-srv

set -e

echo "Stopping any running shrmpl app services..."

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Call the stop script to stop all services
"$SCRIPT_DIR/211-stop-shrmpl-app-infra"

echo "Starting shrmpl infrastructure services..."

# Change to the project root directory
pushd "$PROJECT_ROOT" > /dev/null

# Start services with their configs, order matters - slog first

echo "Starting Log server in Project Root $PROJECT_ROOT..."
./bin/tools/shrmpl-log-srv ./etc/loc-shrmpl-log-srv.env &
echo "✓ Log server started"

sleep 1

echo "Starting KV server..."
./bin/tools/shrmpl-kv-srv ./etc/loc-shrmpl-kv-srv.env &
echo "✓ KV server started"



echo "Starting Vault server..."
./bin/tools/shrmpl-vault-srv ./etc/loc-shrmpl-vault-srv.env &
echo "✓ Vault server started"

echo ""
echo "Infrastructure services started in the background."
echo "To stop them, run: ./bin/211-stop-shrmpl-app-infra"

# Return to original directory
popd > /dev/null
