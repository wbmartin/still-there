#!/bin/bash

# Script to stop any running shrmpl infrastructure services and start them with local configs
# Services: skv-srv, slog-srv, shrmpl-vault-srv

set -e

echo "Stopping any running shrmpl infrastructure services..."

# Kill existing processes
pkill -f "shrmpl-kv-srv" || echo "No shrmpl-kv-srv processes found"
pkill -f "shrmpl-log-srv" || echo "No shrmpl-log-srv processes found"
pkill -f "shrmpl-vault-srv" || echo "No shrmpl-vault-srv processes found"

# Wait a moment for processes to terminate
sleep 2

echo "Starting shrmpl infrastructure services..."

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to the project root directory
pushd "$PROJECT_ROOT" > /dev/null

# Start services with their configs, order matters - slog first

echo "Starting Log server in Project Root $PROJECT_ROOT..."
./bin/tools/shrmpl-log-srv ./etc/shrmpl-log-srv-loc.env &
echo "✓ Log server started"

sleep 1

echo "Starting KV server..."
./bin/tools/shrmpl-kv-srv ./etc/shrmpl-kv-srv-loc.env &
echo "✓ KV server started"



echo "Starting Vault server..."
./bin/tools/shrmpl-vault-srv ./etc/shrmpl-vault-srv-loc.env &
echo "✓ Vault server started"

echo ""
echo "All services started in the background."
echo "To stop them, run: pkill -f 'shrmpl-kv-srv|shrmpl-log-srv|shrmpl-vault-srv'"

# Return to original directory
popd > /dev/null
