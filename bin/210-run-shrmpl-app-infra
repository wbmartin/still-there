#!/bin/bash

# Script to stop any running shrmpl infrastructure services and start them with local configs
# Services: skv-srv, slog-srv, shrmpl-vault-srv

set -e

echo "Stopping any running shrmpl infrastructure services..."

# Kill existing processes and track if any were killed
KILLED_PROCESSES=false

if pkill -f "shrmpl-kv-srv" 2>/dev/null; then
    echo "Killed shrmpl-kv-srv processes"
    KILLED_PROCESSES=true
else
    echo "No shrmpl-kv-srv processes found"
fi

if pkill -f "shrmpl-log-srv" 2>/dev/null; then
    echo "Killed shrmpl-log-srv processes"
    KILLED_PROCESSES=true
else
    echo "No shrmpl-log-srv processes found"
fi

if pkill -f "shrmpl-vault-srv" 2>/dev/null; then
    echo "Killed shrmpl-vault-srv processes"
    KILLED_PROCESSES=true
else
    echo "No shrmpl-vault-srv processes found"
fi

if pkill -f "shrmpl-kv-cli" 2>/dev/null; then
    echo "Killed shrmpl-kv-cli processes"
    KILLED_PROCESSES=true
else
    echo "No shrmpl-kv-cli processes found"
fi

# Wait for processes to terminate only if we killed any
if [ "$KILLED_PROCESSES" = true ]; then
    echo "Waiting for processes to terminate..."
    sleep 3
fi

echo "Starting shrmpl infrastructure services..."

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to the project root directory
pushd "$PROJECT_ROOT" > /dev/null

# Start services with their configs, order matters - slog first

echo "Starting Log server in Project Root $PROJECT_ROOT..."
./bin/tools/shrmpl-log-srv ./etc/loc-shrmpl-log-srv.env &
echo "✓ Log server started"

sleep 1

echo "Starting KV server..."
./bin/tools/shrmpl-kv-srv ./etc/loc-shrmpl-kv-srv.env &
echo "✓ KV server started"



echo "Starting Vault server..."
./bin/tools/shrmpl-vault-srv ./etc/loc-shrmpl-vault-srv.env &
echo "✓ Vault server started"

echo ""
echo "All services started in the background."
echo "To stop them, run: pkill -f 'shrmpl-kv-srv|shrmpl-log-srv|shrmpl-vault-srv|shrmpl-kv-cli'"

# Return to original directory
popd > /dev/null
