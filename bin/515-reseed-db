#!/bin/bash

# Return a scratch database to its seeded state, WITHOUT dropping it.
#
#   bin/515-reseed-db                    # loc_<slug>_e2e_db (E2E_DB from etc/loc-test.env)
#   bin/515-reseed-db loc_<slug>_test_db # any *_test_db / *_e2e_db
#
# The obvious way to reset is DROP DATABASE, which 510 does. It cannot be used
# between test runs: the API server is already running by the time Playwright's
# global setup executes, and dropping the database underneath it leaves every
# connection in its pgx pool pointing at something that no longer exists. The
# first requests afterwards fail, the web app correctly reports "Cannot reach
# the server", and the suite fails for a reason that has nothing to do with the
# code under test.
#
# TRUNCATE leaves the connections valid. Every domain table is truncated and
# sql/fixtures/test-seed.sql re-run, so the groups, the three users and the
# two example rows come back exactly as bin/510 seeded them (tenants 2 and 3)
# and anything a previous run created is gone. TRUNCATE keeps bin/510's
# CHECK (security_context_id <> 1); test-tenant-lock.sql is re-run after the
# seed (it skips tables already locked) so a database built before a table
# existed is covered too.
#
# Falls back to the full rebuild (bin/510) when the database is not there yet,
# so a fresh checkout needs no separate setup step.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
# shellcheck disable=SC1091
source "$PROJECT_ROOT/etc/app.env"
# shellcheck disable=SC1091
[ -n "${TEST_PG_URL_BASE:-}" ] || source "$PROJECT_ROOT/etc/loc-test.env"
DB="${1:-${E2E_DB:-loc_${APP_SLUG}_e2e_db}}"
case "$DB" in
  *_test_db|*_e2e_db) ;;
  *) echo "[ERROR] Refusing to reseed '$DB': scratch databases end in _test_db or _e2e_db"; exit 1 ;;
esac
FIXTURES_DIR="$PROJECT_ROOT/src/api-srv/sql/fixtures"

# Same psql selection as bin/510.
# Postgres is whatever listens on $PGHOST:$PGPORT -- a container, a native
# server, anything. psql reaches it over TCP at that same address the migrator
# uses, so the two can never land on different servers. PSQL overrides it
# outright (e.g. PSQL="docker exec -i loc-postgres psql -U postgres").
for var in PGHOST PGPORT PGUSER; do
  [ -n "${!var:-}" ] || { echo "[ERROR] $var is not set (etc/loc-test.env sets it)"; exit 1; }
done
if [ -z "${PSQL:-}" ]; then
  command -v psql >/dev/null 2>&1 || {
    echo "[ERROR] psql not found. Install the Postgres client, or set PSQL"
    echo "        (see etc/loc-test.env)"
    exit 1
  }
  PSQL="psql -h $PGHOST -p $PGPORT -U $PGUSER"
fi
echo "[INFO] psql -> $PGHOST:$PGPORT as $PGUSER"
export PGPASSWORD

# Listed first, not piped: a failed psql must stop the script, not read as
# "database missing" and trigger a DROP and rebuild.
DB_LIST="$($PSQL -d postgres -lqt)"
if ! grep -qw "$DB" <<< "$(cut -d \| -f 1 <<< "$DB_LIST")"; then
  echo "[INFO] $DB does not exist yet; building it"
  exec "$SCRIPT_DIR/510-reset-test-db" "$DB"
fi

# RESTART IDENTITY so ids are stable run to run: the seeded rows get the same
# ids every time, which makes a failing run far easier to reason about
# against the database. schema_migrations is deliberately not in the list.
$PSQL -d "$DB" -q -v ON_ERROR_STOP=1 -c "
TRUNCATE TABLE
  example,
  app_user,
  app_user_group
RESTART IDENTITY CASCADE;"

$PSQL -d "$DB" -q -v ON_ERROR_STOP=1 < "$FIXTURES_DIR/test-seed.sql"
$PSQL -d "$DB" -q -v ON_ERROR_STOP=1 < "$FIXTURES_DIR/test-tenant-lock.sql"

echo "[INFO] $DB reseeded"
