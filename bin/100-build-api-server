#!/bin/bash

# Build the API server binary
# Output: dist/proto-go-app

set -e

# Get the directory of this script (BASH_SOURCE[0])
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BINARY_PATH="$PROJECT_ROOT/dist/proto-go-app"

echo "Building API server..."

# Change to the API server source directory
pushd "$PROJECT_ROOT/src/api-srv" > /dev/null

# Format Go code with golines
echo "Formatting Go code..."
golines -m 80 -w .

# Build the binary
go build -o "$BINARY_PATH" ./cmd/server

# Return to original directory
popd > /dev/null

echo "API server built successfully: $BINARY_PATH"
