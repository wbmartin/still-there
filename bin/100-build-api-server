#!/bin/bash

# Build the API server and migrator binaries
# Output: dist/<slug>-api, dist/<slug>-migrate (slug from etc/app.env)

set -e

# Get the directory of this script (BASH_SOURCE[0])
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
# shellcheck disable=SC1091
source "$PROJECT_ROOT/etc/app.env"
BINARY_PATH="$PROJECT_ROOT/dist/$APP_SLUG-api"
MIGRATE_PATH="$PROJECT_ROOT/dist/$APP_SLUG-migrate"

echo "Building API server..."

# Change to the API server source directory
pushd "$PROJECT_ROOT/src/api-srv" > /dev/null

# Build the binaries
go build -o "$BINARY_PATH" ./cmd/server
go build -o "$MIGRATE_PATH" ./cmd/migrate

# Return to original directory
popd > /dev/null

echo "API server built successfully: $BINARY_PATH"
echo "Migrator built successfully: $MIGRATE_PATH"
