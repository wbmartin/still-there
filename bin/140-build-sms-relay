#!/bin/bash

# Build the SMS relay for prd-wbm: linux/amd64, static (no cgo)
# Output: dist/sms-relay (src/sms-relay/README.md, Deploy)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BINARY_PATH="$PROJECT_ROOT/dist/sms-relay"

echo "Building SMS relay..."
mkdir -p "$PROJECT_ROOT/dist"
pushd "$PROJECT_ROOT/src/sms-relay" > /dev/null
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o "$BINARY_PATH" .
popd > /dev/null

echo "SMS relay built successfully: $BINARY_PATH"
