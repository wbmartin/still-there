#!/bin/bash

# Build and package web app for deployment
# This script builds the web app and creates a tar.gz archive ready for deployment

set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Change to project root directory
pushd "$PROJECT_ROOT" > /dev/null

# Generate timestamp for the archive filename
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
ARCHIVE_NAME="web-app_${TIMESTAMP}.tar.gz"

echo "Building and packaging web app for deployment..."
echo "Archive will be created as: $ARCHIVE_NAME"

# Change to web-app directory and build
echo "Building web app..."
cd src/web-app

# Clean any existing dist directory
rm -rf dist

# Build the web app (uses production mode by default)
npm run build

# Check if build was successful
if [ ! -d "dist" ]; then
    echo "❌ ERROR: Build failed - dist directory not found"
    exit 1
fi

echo "✅ Build completed successfully"

# Create tar.gz archive
echo "Creating deployment archive..."
if [ ! -d "dist" ]; then
    echo "❌ ERROR: dist directory not found"
    exit 1
fi
echo "Contents of dist directory:"
ls -la dist/
cd dist
echo "Creating archive from: $(pwd)"
tar -czf "../../../$ARCHIVE_NAME" .

# Verify archive was created
if [ ! -f "../../../$ARCHIVE_NAME" ]; then
    echo "❌ ERROR: Failed to create archive"
    exit 1
fi

# Get archive size
ARCHIVE_SIZE=$(du -h "../../../$ARCHIVE_NAME" | cut -f1)

echo "✅ Deployment archive created successfully"
echo "📦 Archive: $ARCHIVE_NAME"
echo "📏 Size: $ARCHIVE_SIZE"
echo ""
echo "To deploy:"
echo "  1. Copy $ARCHIVE_NAME to your web server"
echo "  2. Extract: tar -xzf $ARCHIVE_NAME"
echo "  3. Configure nginx to serve the extracted files"

# Return to original directory
popd > /dev/null