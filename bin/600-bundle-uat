#!/bin/bash
# Build + bundle + ship a presales UAT deploy for this app.
#   1. Go API server, linux/amd64 static       -> api-srv
#   2. Go migrator, linux/amd64 static          -> <slug>-migrate (if cmd/migrate exists)
#   3. Web app (vite production build)          -> web-pub.tar.gz
#   4. Local Postgres dump (plain SQL)          -> db.sql
#   5. src/api-srv/sql/roles.sql + server-side deploy script
#   6. etc/uat-api-srv.env.template, names filled  -> api-srv.env.template
#      (no secrets: 610 generates them on the host, once)
#   7. etc/uat-nginx-site.conf.template         -> nginx-site.conf.template
#      (610 fills and installs it once, for UAT_DOMAIN)
# Output: dist/${APP_NAME}_bundle_YYYYMMDD_hhmm.tar.gz, scp'd to $UAT_HOST:/tmp/
# The bundle holds a full pg_dump, so it does not stay in dist/: a successful
# scp deletes it, a failed scp keeps it (and prints the retry), --no-scp keeps
# it. Every run names any earlier bundle left in dist/ and prints the rm.
#
# This is the presales (pre-agreement) quick-deploy path: local build + local DB dump
# replace UAT wholesale. The full-fat webhook/registry + migrator path is the
# post-agreement upgrade — see doc/320-presales-uat-deploy.md.
#
# Usage: bin/600-bundle-uat [--no-scp] [--no-db]
# Settings: etc/uat-deploy.env (PRESALES_ENV=<file> to use another). Every key is
# required; there are no inline defaults. Everything that can fail is checked
# before the first build so a bad env dies in seconds, not after a minute of go+vite.
#
# The database it dumps is the one LOCAL_ENV_FILE names, on the Postgres that
# etc/loc-test.env describes -- PGHOST, PGPORT, PGUSER, PGPASSWORD, the same
# address bin/205 and bin/510 use. psql and pg_dump both connect there over
# TCP, so this cannot dump a different server than the one the dev tooling
# built. There is deliberately no container escape hatch: running one of the
# two inside a container is how the two halves came apart before.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_ROOT"

# shellcheck disable=SC1091
source "$PROJECT_ROOT/etc/app.env"
PRESALES_ENV="${PRESALES_ENV:-$PROJECT_ROOT/etc/uat-deploy.env}"
[ -r "$PRESALES_ENV" ] || { echo "[ERROR] $PRESALES_ENV missing or unreadable"; exit 1; }
# shellcheck disable=SC1090
source "$PRESALES_ENV"
for var in APP_NAME UAT_HOST LOCAL_ENV_FILE APP_ROOT SERVICE SVC_USER DB_APP_ROLE DB_NAME UAT_DOMAIN; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var not set by $PRESALES_ENV"; exit 1; }
done
# The laptop's Postgres, as the `postgres` role: the app role in LOCAL_ENV_FILE
# is DML-only. Same file, same address, same role as bin/205 and bin/510.
# shellcheck disable=SC1091
[ -n "${PGHOST:-}" ] || source "$PROJECT_ROOT/etc/loc-test.env"
for var in PGHOST PGPORT PGUSER; do
    [ -n "${!var:-}" ] || { echo "[ERROR] $var is not set (etc/loc-test.env sets it)"; exit 1; }
done
export PGHOST PGPORT PGUSER PGPASSWORD
# goes into an nginx server_name and a file name on the host: no room for more
[[ "$UAT_DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] \
  || { echo "[ERROR] UAT_DOMAIN=$UAT_DOMAIN is not a lower-case hostname"; exit 1; }
[ -n "${APP_DISPLAY_NAME:-}" ] || { echo "[ERROR] APP_DISPLAY_NAME not set by etc/app.env"; exit 1; }
case "$LOCAL_ENV_FILE" in /*) ;; *) LOCAL_ENV_FILE="$PROJECT_ROOT/$LOCAL_ENV_FILE" ;; esac
[ -r "$LOCAL_ENV_FILE" ] || { echo "[ERROR] LOCAL_ENV_FILE not readable: $LOCAL_ENV_FILE"; exit 1; }
DO_SCP=1; DO_DB=1
for a in "$@"; do
  case "$a" in
    --no-scp) DO_SCP=0 ;;
    --no-db)  DO_DB=0 ;;
    *) echo "unknown arg: $a"; exit 2 ;;
  esac
done

# --- preflight: everything the dump step needs, before any build --------------
ROLES_SQL="$PROJECT_ROOT/src/api-srv/sql/roles.sql"
ENV_TEMPLATE="$PROJECT_ROOT/etc/uat-api-srv.env.template"
[ -f "$ENV_TEMPLATE" ] || { echo "[ERROR] $ENV_TEMPLATE missing"; exit 1; }
NGINX_TEMPLATE="$PROJECT_ROOT/etc/uat-nginx-site.conf.template"
[ -f "$NGINX_TEMPLATE" ] || { echo "[ERROR] $NGINX_TEMPLATE missing"; exit 1; }
LOCAL_DB=""
if [ "$DO_DB" = 1 ]; then
  LOCAL_DB="$(sed -nE 's#^DATABASE_URL=postgres://[^/]+/([^?]+).*#\1#p' "$LOCAL_ENV_FILE" | head -1)"
  [ -n "$LOCAL_DB" ] || { echo "[ERROR] cannot determine the local database from $LOCAL_ENV_FILE (add an inline DATABASE_URL, or use --no-db)"; exit 1; }
  [ -f "$ROLES_SQL" ] || { echo "[ERROR] $ROLES_SQL missing (it ships in the bundle as 000-roles.sql)"; exit 1; }
  grep -q "$DB_APP_ROLE" "$ROLES_SQL" || { echo "[ERROR] DB_APP_ROLE=$DB_APP_ROLE is not created by $ROLES_SQL"; exit 1; }
  for tool in psql pg_dump; do
    command -v "$tool" >/dev/null 2>&1 \
      || { echo "[ERROR] $tool not found: install the Postgres client (doc/050-dev-env-init.md)"; exit 1; }
  done
  echo "      db -> $PGHOST:$PGPORT as $PGUSER"
  psql -X -Atq -d "$LOCAL_DB" -c 'select 1' >/dev/null 2>&1 \
    || { echo "[ERROR] cannot connect to database $LOCAL_DB at $PGHOST:$PGPORT as $PGUSER (server down, no such database, or wrong password)"; exit 1; }
  # pg_dump refuses a server newer than itself. Checked here, because step 4
  # runs after a minute of go and vite.
  SERVER_MAJOR="$(( $(psql -X -Atq -d "$LOCAL_DB" \
      -c 'SHOW server_version_num') / 10000 ))"
  DUMP_MAJOR="$(pg_dump --version | sed -nE 's/^pg_dump \(PostgreSQL\) ([0-9]+).*/\1/p')"
  [ -n "$DUMP_MAJOR" ] || { echo "[ERROR] cannot read a version from pg_dump --version"; exit 1; }
  [ "$DUMP_MAJOR" -ge "$SERVER_MAJOR" ] \
    || { echo "[ERROR] pg_dump $DUMP_MAJOR cannot dump the Postgres $SERVER_MAJOR server at $PGHOST:$PGPORT; install a client that new"; exit 1; }
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo n/a)"
COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo n/a)"
# Dirty = anything the build can see that HEAD does not hold: unstaged,
# staged (git diff alone misses `git add`ed work) and untracked files.
DIRTY=""
[ -z "$(git status --porcelain 2>/dev/null)" ] || DIRTY="(dirty)"
echo "app=$APP_NAME branch=$BRANCH  commit=$COMMIT${DIRTY:+ $DIRTY}"
STAMP="$(date +%Y%m%d_%H%M)"
NAME="${APP_NAME}_bundle_${STAMP}"
STAGE="$PROJECT_ROOT/dist/$NAME"
TARBALL="$PROJECT_ROOT/dist/$NAME.tar.gz"
rm -rf "$STAGE"; mkdir -p "$STAGE"
# a failed build must not leave the staged db.sql in dist/
trap 'rm -rf "$STAGE"' EXIT

# --- 1. API server (static linux/amd64) -------------------------------------
echo "[1/5] go build api-srv (linux/amd64)"
( cd src/api-srv && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o "$STAGE/api-srv" ./cmd/server )
file "$STAGE/api-srv" | sed 's/^/      /'

# --- 2. Migrator (static linux/amd64), if present ---------------------------
echo "[2/5] go build $APP_SLUG-migrate (linux/amd64)"
if [ -d src/api-srv/cmd/migrate ]; then
  ( cd src/api-srv && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
      go build -trimpath -ldflags="-s -w" -o "$STAGE/$APP_SLUG-migrate" ./cmd/migrate )
  file "$STAGE/$APP_SLUG-migrate" | sed 's/^/      /'
else
  echo "      WARNING: src/api-srv/cmd/migrate not found — skipping $APP_SLUG-migrate (migrator not added yet)"
fi

# --- 3. Web app --------------------------------------------------------------
echo "[3/5] vite build web-app"
( cd src/web-app && rm -rf dist && npm run build >/dev/null )
[ -f src/web-app/dist/index.html ] || { echo "web build failed"; exit 1; }
COPYFILE_DISABLE=1 tar --no-xattrs -C src/web-app/dist -czf "$STAGE/web-pub.tar.gz" .

# --- 4. Database dump ---------------------------------------------------------
if [ "$DO_DB" = 1 ]; then
  echo "[4/5] pg_dump $LOCAL_DB from $PGHOST:$PGPORT (plain SQL)"
  pg_dump -d "$LOCAL_DB" \
      --no-owner --no-privileges --format=plain --encoding=UTF8 > "$STAGE/db.sql"
  echo "      $(grep -c '^CREATE TABLE' "$STAGE/db.sql") tables, $(du -h "$STAGE/db.sql" | cut -f1)"

  # roles.sql is mandatory (CLAUDE.md); 610 runs it as superuser before the restore
  cp "$ROLES_SQL" "$STAGE/000-roles.sql"
else
  echo "[4/5] db dump skipped (--no-db)"
fi

# --- 5. Deploy script + manifest ---------------------------------------------
echo "[5/5] pack"
cp "$SCRIPT_DIR/610-deploy-uat" "$STAGE/deploy.sh"; chmod +x "$STAGE/deploy.sh"
# server-side settings for deploy.sh; $APP_ROOT/etc/deploy.env on the host overrides
printf 'APP_NAME=%s\nAPP_ROOT=%s\nSERVICE=%s\nSVC_USER=%s\nDB_APP_ROLE=%s\nUAT_DOMAIN=%s\n' \
    "$APP_NAME" "$APP_ROOT" "$SERVICE" "$SVC_USER" "$DB_APP_ROLE" "$UAT_DOMAIN" \
    > "$STAGE/deploy.env"
# placeholders only; 610 fills them on the host, where APP_ROOT may be
# overridden and SERVER_PORT is read from api-srv.env
cp "$NGINX_TEMPLATE" "$STAGE/nginx-site.conf.template"
# names only; the __DB_PASSWORD__/__JWT_SECRET__/__TOTP_KEY__ placeholders
# stay for 610 to fill on the host (literal replace: no regex, no & expansion)
DB_APP_ROLE="$DB_APP_ROLE" DB_NAME="$DB_NAME" SERVER_NAME="$SERVICE" \
APP_DISPLAY_NAME="$APP_DISPLAY_NAME" awk '
  function put(key,   token, i) {
    token = "__" key "__"
    while ((i = index($0, token)) > 0)
      $0 = substr($0, 1, i - 1) ENVIRON[key] substr($0, i + length(token))
  }
  { put("DB_APP_ROLE"); put("DB_NAME"); put("SERVER_NAME")
    put("APP_DISPLAY_NAME"); print }' "$ENV_TEMPLATE" > "$STAGE/api-srv.env.template"
{
  echo "bundle=$NAME"
  echo "app=$APP_NAME"
  echo "built=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "branch=$BRANCH"
  echo "git=$COMMIT $DIRTY"
  echo "go=$(go version | awk '{print $3}')  node=$(node --version)"
  echo "db=${LOCAL_DB:-skipped}"
  echo "domain=$UAT_DOMAIN"
  [ -f "$STAGE/$APP_SLUG-migrate" ] && echo "migrate=included" || echo "migrate=not-built"
} > "$STAGE/MANIFEST"
COPYFILE_DISABLE=1 tar --no-xattrs -C "$PROJECT_ROOT/dist" -czf "$TARBALL" "$NAME"
rm -rf "$STAGE"
echo "      $TARBALL ($(du -h "$TARBALL" | cut -f1))"

# --- ship ------------------------------------------------------------------
if [ "$DO_SCP" = 1 ]; then
  echo "scp -> $UAT_HOST:/tmp/$NAME.tar.gz"
  if ! scp -q "$TARBALL" "$UAT_HOST:/tmp/$NAME.tar.gz"; then
    echo "[ERROR] scp failed; the bundle stays in dist/. Retry with:"
    echo "  scp $TARBALL $UAT_HOST:/tmp/$NAME.tar.gz"
    echo "  rm -f $TARBALL   # once it is on the host"
    exit 1
  fi
  # the host has its copy; the local one is a full DB dump with no further use
  rm -f "$TARBALL"
  echo "      removed $TARBALL (the host copy is /tmp/$NAME.tar.gz)"
  echo
  echo "Next, on the server:"
  echo "  ssh $UAT_HOST"
  echo "  cd /tmp && tar xzf $NAME.tar.gz && sudo ./$NAME/deploy.sh   # add --no-db to keep the server DB"
else
  echo "scp skipped (--no-scp); $TARBALL stays: delete it once copied"
fi

# --- earlier bundles ---------------------------------------------------------
# Never deleted automatically: name them and print the rm. A directory is the
# staging dir of a run that died before this script cleaned up after itself.
EARLIER_LIST=()
for path in "$PROJECT_ROOT/dist/${APP_NAME}_bundle_"*; do
  [ -e "$path" ] || continue
  [ "$path" = "$TARBALL" ] && continue
  EARLIER_LIST+=("$path")
done
if [ "${#EARLIER_LIST[@]}" -gt 0 ]; then
  echo
  echo "[WARN] earlier bundles in dist/, each may hold a full DB dump."
  echo "  Remove them with:"
  for path in "${EARLIER_LIST[@]}"; do
    if [ -d "$path" ]; then echo "  rm -rf $path"; else echo "  rm -f $path"; fi
  done
fi
